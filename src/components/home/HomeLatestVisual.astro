---
import type { Language } from '../../utils/i18n';
import { homeContent, localeFor } from '../../utils/homeContent';
import type { VisualGalleryItem } from '../../utils/visuals';

interface Props {
  lang: Language;
  visuals: VisualGalleryItem[];
}

const { lang, visuals } = Astro.props;
const c = homeContent[lang];
const basePath = lang === 'zh' ? '/cn' : lang === 'ja' ? '/ja' : '';
const homeVisuals = visuals.map((visual) => ({
  ...visual,
  dateLabel: new Date(visual.publishedAt).toLocaleDateString(localeFor(lang), {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
  isAirConditioner: visual.cover === 'air-conditioner',
  isTyphoon: visual.cover === 'typhoon',
  isLoopEngineering: visual.cover === 'loop-engineering',
  isPriceVolume: visual.cover === 'price-volume',
  isEnsoFoodPrices: visual.cover === 'enso-food-prices',
  isPrisonersDilemma: visual.cover === 'prisoners-dilemma',
  isButterflyEffect: visual.cover === 'butterfly-effect',
}));
---

{visuals.length > 0 && (
  <section data-home-visuals class="mx-auto max-w-6xl px-4 pb-14 md:pb-16" aria-labelledby="home-visuals-title">
    <div class="mb-5 flex items-center justify-between gap-4">
      <h2 id="home-visuals-title" class="flex items-center gap-3 font-display text-2xl font-bold text-surface-900 dark:text-white">
        <span class="inline-block h-6 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        {c.visualsSectionTitle}
      </h2>
      <a href={`${basePath}/visuals/`} class="shrink-0 text-sm font-medium text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400">
        {c.viewAllVisuals} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="space-y-6">
      {homeVisuals.map((visual) => (
        <a
          data-home-visual-card={visual.slug}
          href={visual.href}
          aria-label={visual.title}
          class="reveal-init group grid overflow-hidden rounded-3xl border border-surface-200/80 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover dark:border-surface-800 dark:bg-surface-900 md:grid-cols-[minmax(0,1.05fr)_minmax(22rem,.95fr)]"
        >
      <div class="flex flex-col justify-center p-7 md:p-10">
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-accent-600 dark:text-accent-400">
          <span>{c.visualTypeLabels[visual.type]}</span>
          <span class="h-1 w-1 rounded-full bg-surface-300 dark:bg-surface-700" aria-hidden="true"></span>
          <time datetime={visual.publishedAt} class="normal-case tracking-normal text-surface-500 dark:text-surface-400">{visual.dateLabel}</time>
        </div>
        <h3 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-surface-950 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-300 md:text-4xl">
          {visual.title}
        </h3>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-surface-600 dark:text-surface-300 md:text-lg">{visual.description}</p>
        <span class="mt-7 inline-flex items-center gap-2 font-semibold text-brand-600 dark:text-brand-300">
          {c.openVisual}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </div>

      <div class="relative min-h-64 overflow-hidden bg-gradient-to-br from-slate-950 via-cyan-900 to-teal-500 md:min-h-80" aria-hidden="true">
        <div class="absolute inset-0 opacity-80 [background-image:radial-gradient(circle_at_20%_18%,rgba(255,255,255,.5)_0_2px,transparent_3px),radial-gradient(circle_at_82%_70%,rgba(255,255,255,.32)_0_3px,transparent_4px)] [background-size:72px_72px,116px_116px]"></div>
        {visual.isPriceVolume ? (
          <>
            <div class="absolute inset-8 rounded-[2rem] border border-white/15 bg-slate-950/35 backdrop-blur-sm"></div>
            <div class="absolute bottom-[18%] left-[12%] flex h-[52%] w-[76%] items-end gap-3">
              <div class="h-[28%] flex-1 rounded-t-md bg-amber-300/40"></div>
              <div class="h-[43%] flex-1 rounded-t-md bg-amber-300/55"></div>
              <div class="h-[36%] flex-1 rounded-t-md bg-amber-300/45"></div>
              <div class="h-[69%] flex-1 rounded-t-md bg-amber-300/75"></div>
              <div class="h-[56%] flex-1 rounded-t-md bg-amber-300/55"></div>
              <div class="h-[83%] flex-1 rounded-t-md bg-amber-300/70"></div>
            </div>
            <div class="absolute left-[12%] top-[34%] h-[3px] w-[76%] -rotate-6 bg-cyan-200/85 shadow-[0_0_18px_rgba(165,243,252,.7)]"></div>
            <div class="absolute right-[12%] top-[18%] rounded-full border border-rose-200/40 bg-rose-300/15 px-3 py-1 text-xs font-bold tracking-wide text-rose-100">P × V</div>
          </>
        ) : visual.isAirConditioner ? (
          <>
            <div class="absolute left-[8%] top-[24%] h-36 w-44 rounded-[2rem] border border-cyan-100/30 bg-cyan-100/10 shadow-[0_0_55px_rgba(103,232,249,.2)] backdrop-blur-sm"></div>
            <div class="absolute right-[8%] top-[24%] h-36 w-44 rounded-[2rem] border border-amber-100/30 bg-amber-100/10 shadow-[0_0_55px_rgba(251,191,36,.18)] backdrop-blur-sm"></div>
            <div class="absolute left-[18%] top-[39%] h-16 w-16 rounded-full border-[6px] border-cyan-100/45 shadow-[inset_0_0_20px_rgba(103,232,249,.22)]"></div>
            <div class="absolute right-[18%] top-[39%] h-16 w-16 rounded-full border-[6px] border-amber-100/45 shadow-[inset_0_0_20px_rgba(251,191,36,.2)] motion-safe:animate-[spin_3s_linear_infinite]"></div>
            <div class="absolute left-[32%] top-[33%] h-px w-[36%] bg-gradient-to-r from-cyan-200/60 via-white/80 to-amber-200/60"></div>
            <div class="absolute left-[32%] top-[65%] h-px w-[36%] bg-gradient-to-l from-cyan-200/60 via-white/80 to-amber-200/60"></div>
            <div class="absolute left-[27%] top-[22%] h-[58%] w-[46%] rounded-[50%] border border-dashed border-white/30 motion-safe:animate-[spin_16s_linear_infinite]"></div>
            <div class="absolute left-[14%] top-[17%] text-3xl text-cyan-100/75">↓</div>
            <div class="absolute right-[14%] top-[17%] text-3xl text-amber-100/75">↑</div>
          </>
        ) : visual.isLoopEngineering ? (
          <>
            <div class="absolute inset-8 rounded-[2rem] border border-white/15 bg-slate-950/25 backdrop-blur-sm"></div>
            <div class="absolute left-[12%] top-1/2 h-16 w-28 -translate-y-1/2 rounded-2xl border border-cyan-200/35 bg-cyan-100/10"></div>
            <div class="absolute left-[38%] top-[22%] h-16 w-28 rounded-2xl border border-indigo-200/40 bg-indigo-100/10"></div>
            <div class="absolute right-[12%] top-1/2 h-16 w-28 -translate-y-1/2 rounded-2xl border border-teal-200/40 bg-teal-100/10"></div>
            <div class="absolute bottom-[16%] left-[38%] h-16 w-28 rounded-2xl border border-amber-200/35 bg-amber-100/10"></div>
            <div class="absolute left-[28%] top-[43%] h-px w-[18%] bg-gradient-to-r from-cyan-200/20 to-indigo-100/70"></div>
            <div class="absolute right-[28%] top-[43%] h-px w-[18%] bg-gradient-to-r from-indigo-100/70 to-teal-200/20"></div>
            <div class="absolute bottom-[31%] left-[45%] h-[18%] w-px bg-gradient-to-b from-teal-100/70 to-amber-200/20"></div>
            <div class="absolute left-[18%] top-[28%] h-[48%] w-[64%] rounded-[50%] border border-dashed border-white/25 motion-safe:animate-[spin_18s_linear_infinite]"></div>
            <div class="absolute left-1/2 top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white shadow-[0_0_28px_rgba(255,255,255,.85)]"></div>
          </>
        ) : visual.isTyphoon ? (
          <>
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_54%_50%,rgba(255,255,255,.95)_0_5%,rgba(103,232,249,.42)_6%_11%,transparent_12%)]"></div>
            <div class="absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full border-[18px] border-white/15 shadow-[0_0_70px_rgba(103,232,249,.35)] motion-safe:animate-[spin_18s_linear_infinite]"></div>
            <div class="absolute left-1/2 top-1/2 h-36 w-64 -translate-x-1/2 -translate-y-1/2 -rotate-[28deg] rounded-[50%] border-[12px] border-cyan-100/20"></div>
            <div class="absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/50 bg-slate-950/75 shadow-[inset_0_0_24px_rgba(255,255,255,.15)]"></div>
          </>
        ) : visual.isEnsoFoodPrices ? (
          <>
            {/* Equatorial warm tongue + rising grocery prices — distinct from typhoon eye */}
            <div class="absolute inset-x-0 top-[34%] h-[34%] bg-gradient-to-r from-sky-950/10 via-cyan-800/40 to-sky-950/10"></div>
            <div class="absolute left-[6%] top-[48%] h-7 w-[88%] rounded-full bg-gradient-to-r from-amber-300/30 via-orange-400/85 to-rose-400/60 shadow-[0_0_40px_rgba(251,146,60,.5)]"></div>
            <div class="absolute left-[18%] top-[50%] h-3.5 w-[48%] rounded-full bg-gradient-to-r from-yellow-100/80 to-orange-300/35"></div>
            <div class="absolute bottom-[14%] right-[8%] flex h-[46%] w-[26%] items-end gap-1.5">
              <div class="h-[30%] flex-1 rounded-t-md bg-emerald-200/40"></div>
              <div class="h-[52%] flex-1 rounded-t-md bg-emerald-200/55"></div>
              <div class="h-[72%] flex-1 rounded-t-md bg-amber-200/55"></div>
              <div class="h-[92%] flex-1 rounded-t-md bg-rose-300/75"></div>
            </div>
            <div class="absolute bottom-[58%] right-[10%] text-2xl font-bold text-rose-100/95">↗</div>
            <div class="absolute left-[10%] top-[18%] rounded-full border border-cyan-100/30 bg-cyan-100/10 px-3 py-1 text-xs font-bold tracking-wide text-cyan-50/90">ENSO</div>
          </>
        ) : visual.isPrisonersDilemma ? (
          <>
            {/* Payoff matrix / two-cell game — distinct from typhoon eye */}
            <div class="absolute left-1/2 top-[14%] h-[68%] w-[70%] -translate-x-1/2 rounded-[1.75rem] border border-white/20 bg-slate-950/40 p-3 backdrop-blur-sm">
              <div class="grid h-full grid-cols-2 grid-rows-2 gap-2">
                <div class="flex flex-col items-center justify-center gap-1 rounded-2xl border border-emerald-200/45 bg-emerald-300/25">
                  <span class="text-sm font-bold text-emerald-50">C·C</span>
                  <span class="text-[10px] font-semibold text-emerald-100/80">1 , 1</span>
                </div>
                <div class="flex flex-col items-center justify-center gap-1 rounded-2xl border border-amber-200/35 bg-amber-300/15">
                  <span class="text-sm font-bold text-amber-50/90">C·D</span>
                  <span class="text-[10px] font-semibold text-amber-100/70">3 , 0</span>
                </div>
                <div class="flex flex-col items-center justify-center gap-1 rounded-2xl border border-amber-200/35 bg-amber-300/15">
                  <span class="text-sm font-bold text-amber-50/90">D·C</span>
                  <span class="text-[10px] font-semibold text-amber-100/70">0 , 3</span>
                </div>
                <div class="flex flex-col items-center justify-center gap-1 rounded-2xl border border-rose-200/50 bg-rose-400/40 shadow-[0_0_28px_rgba(251,113,133,.4)]">
                  <span class="text-sm font-bold text-rose-50">D·D</span>
                  <span class="text-[10px] font-semibold text-rose-100/85">2 , 2</span>
                </div>
              </div>
            </div>
            <div class="absolute left-[8%] top-[12%] rounded-full border border-white/30 bg-black/25 px-3 py-1 text-xs font-bold tracking-wide text-white/90">Nash · DD</div>
          </>
        ) : visual.isButterflyEffect ? (
          <>
            <div class="absolute inset-8 rounded-[2rem] border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
            <svg class="absolute inset-0 h-full w-full" viewBox="0 0 420 320" fill="none" aria-hidden="true">
              <path d="M48 200 C 130 196, 175 175, 220 130 C 275 70, 330 45, 380 36" stroke="rgba(103,232,249,.9)" stroke-width="4" stroke-linecap="round"/>
              <path d="M48 204 C 130 210, 180 235, 230 255 C 290 280, 340 265, 380 220" stroke="rgba(251,113,133,.95)" stroke-width="4" stroke-linecap="round"/>
              <circle cx="48" cy="202" r="7" fill="rgba(255,255,255,.95)"/>
            </svg>
            <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-3 py-1 text-xs font-bold tracking-wide text-cyan-50/90">δx₀ → fork</div>
            <div class="absolute right-[12%] top-[16%] text-2xl font-bold text-rose-100/95">↗</div>
          </>
        ) : (
          <div class="absolute inset-12 rounded-3xl border border-white/20 bg-white/10 shadow-[0_0_70px_rgba(103,232,249,.24)] backdrop-blur-sm"></div>
        )}
        <div class="absolute bottom-5 left-5 rounded-full border border-white/25 bg-black/20 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90 backdrop-blur">
          {visual.tags.slice(0, 3).join(' · ')}
        </div>
      </div>
        </a>
      ))}
    </div>
  </section>
)}
