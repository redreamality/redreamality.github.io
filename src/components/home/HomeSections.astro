---
import type { Language } from '../../utils/i18n';
import { homeContent, localeFor } from '../../utils/homeContent';
import SectionGrid, { type SectionItem } from '../shared/SectionGrid.astro';
import chaosDigest from '../../data/chaos-digest.json';

type Entry = { slug: string; data: Record<string, any> };

interface Props {
  lang: Language;
  posts: Entry[];
  meditations: Entry[];
  talks: Entry[];
  questions: Entry[];
  chaos: Entry[];
  notes: Entry[];
  tagCounts: Record<string, number>;
}

const { lang, posts, meditations, talks, questions, chaos, notes, tagCounts } = Astro.props;
const c = homeContent[lang];
const basePath = lang === 'zh' ? '/cn' : lang === 'ja' ? '/ja' : '';
const locale = localeFor(lang);

const fmt = (d: Date) => new Date(d).toLocaleDateString(locale);

const blogItems: SectionItem[] = posts.slice(0, 12).map((p) => ({
  href: `${basePath}/blog/${p.slug}/`,
  title: p.data.title,
  description: p.data.description,
  dateISO: new Date(p.data.pubDate).toISOString(),
  dateLabel: fmt(p.data.pubDate),
  tags: p.data.tags,
  tagBasePath: `${basePath}/tags`,
  tagCounts,
}));

const meditationItems: SectionItem[] = meditations.slice(0, 4).map((m) => ({
  href: `${basePath}/garden/meditations/${m.slug}/`,
  title: m.data.title,
  description: m.data.description,
  dateISO: new Date(m.data.date).toISOString(),
  dateLabel: fmt(m.data.date),
  badges: m.data.theme ? [{ icon: '🪷', label: m.data.theme }] : [],
}));

const talkItems: SectionItem[] = talks.slice(0, 5).map((t) => ({
  href: `${basePath}/garden/talks/${t.slug}/`,
  title: t.data.title,
  description: t.data.description,
  dateISO: new Date(t.data.date).toISOString(),
  dateLabel: fmt(t.data.date),
  badges: t.data.location ? [{ icon: '📍', label: t.data.location }] : [],
}));

const questionItems: SectionItem[] = questions.slice(0, 6).map((q) => ({
  href: `${basePath}/garden/questions/${q.slug}/`,
  title: q.data.title,
  description: q.data.description,
  dateISO: new Date(q.data.date).toISOString(),
  dateLabel: fmt(q.data.date),
}));

const digestLang = lang === 'zh' || lang === 'ja' ? lang : 'en';
const STATUS_RANK: Record<string, number> = {
  published: 0,
  shortlisted: 1,
  writing: 2,
  inbox: 3,
};
const CJK_RE = /[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/;
const hasCJK = (s: string) => CJK_RE.test(s || '');
const asciiRatio = (s: string) =>
  !s?.length ? 1 : (s.match(/[\x00-\x7F]/g) || []).length / s.length;

type ChaosDigestItem = {
  id: string;
  theme?: string;
  title: { zh?: string; en?: string; ja?: string };
  summary: { zh?: string; en?: string; ja?: string };
  judgment?: { zh?: string; en?: string; ja?: string };
  sources: string[];
  score: number;
  status: string;
  externalUrls?: string[];
  blog?: { zh?: string | null; en?: string | null };
};

/** Locale-appropriate title only — never fall back Chinese↔English. */
function chaosLocaleTitle(item: ChaosDigestItem): string | null {
  const t = (item.title?.[digestLang] || '').trim();
  if (!t) return null;
  if (digestLang === 'zh') {
    if (hasCJK(t) || asciiRatio(t) > 0.7) return t;
    return null;
  }
  if (hasCJK(t) && asciiRatio(t) < 0.7) return null;
  return t;
}
function chaosLocaleBlob(blob: { zh?: string; en?: string; ja?: string } | undefined): string {
  const s = (blob?.[digestLang] || '').trim();
  if (!s) return '';
  if (digestLang === 'zh') return s;
  if (hasCJK(s) && asciiRatio(s) < 0.7) return '';
  return s;
}
/** Homepage teaser: judgment one-liner only (prefer judgment, fall back to summary). Never externalUrls. */
function chaosLocaleSummary(item: ChaosDigestItem): string {
  return chaosLocaleBlob(item.judgment) || chaosLocaleBlob(item.summary);
}
function chaosBlogHref(item: ChaosDigestItem): string | null {
  if (!item.blog) return null;
  if (digestLang === 'zh') return item.blog.zh || null;
  return item.blog.en || null; // en + ja use EN blog when present
}

const digestFlat: ChaosDigestItem[] = chaosDigest.hours.flatMap((h) => h.items as ChaosDigestItem[]);
const digestTop = [...digestFlat]
  .filter((item) => chaosLocaleTitle(item) !== null)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return (STATUS_RANK[a.status] ?? 5) - (STATUS_RANK[b.status] ?? 5);
  })
  .slice(0, 6);

const chaosFallback = `${basePath}/garden/chaos/`;
const chaosItems: SectionItem[] =
  digestTop.length > 0
    ? digestTop.map((item) => {
        // Homepage: NEVER use externalUrls — only same-lang blog or Chaos index
        const blog = chaosBlogHref(item);
        const href = blog || chaosFallback;
        return {
          href,
          title: chaosLocaleTitle(item)!,
          description: chaosLocaleSummary(item) || undefined,
          dateISO: chaosDigest.updatedAt,
          dateLabel: fmt(new Date(chaosDigest.updatedAt)),
          badges: [{ label: `${item.score}/5` }],
        };
      })
    : chaos.slice(0, 6).map((p) => ({
        href: `${basePath}/garden/chaos/${p.slug}/`,
        title: p.data.title,
        description: p.data.description,
        dateISO: new Date(p.data.pubDate).toISOString(),
        dateLabel: fmt(p.data.pubDate),
      }));

const noteItems: SectionItem[] = notes.slice(0, 6).map((n) => ({
  href: `${basePath}/garden/notes/${n.slug}/`,
  title: n.data.title,
  description: n.data.description,
  dateISO: new Date(n.data.date).toISOString(),
  dateLabel: fmt(n.data.date),
}));
---

<div class="home-reading mx-auto max-w-6xl px-4">
  <div class="grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <!-- Left: blog -->
    <SectionGrid
      title={c.recentBlogTitle}
      viewAllHref={`${basePath}/blog/`}
      viewAllLabel={c.viewAll}
      columns={1}
      accent="brand"
      items={blogItems}
    />

    <!-- Right: meditations + talks + questions -->
    <div class="reading-sidebar space-y-12">
      <SectionGrid
        title={c.recentMeditationsTitle}
        viewAllHref={`${basePath}/garden/meditations/`}
        viewAllLabel={c.viewAll}
        columns={1}
        accent="ink"
        emptyMessage={c.noMeditationsMessage}
        items={meditationItems}
      />
      <SectionGrid
        title={c.recentTalksTitle}
        viewAllHref={`${basePath}/garden/talks/`}
        viewAllLabel={c.viewAll}
        columns={1}
        accent="accent"
        items={talkItems}
      />
      <SectionGrid
        title={c.recentQuestionsTitle}
        viewAllHref={`${basePath}/garden/questions/`}
        viewAllLabel={c.viewAll}
        columns={1}
        accent="brand"
        emptyMessage={c.noQuestionsMessage}
        items={questionItems}
      />
    </div>
  </div>

  <!-- Full width: chaos + notes -->
  <div class="mt-14 space-y-14">
    <SectionGrid
      title={c.recentChaosTitle}
      viewAllHref={`${basePath}/garden/chaos/`}
      viewAllLabel={c.viewAll}
      columns={3}
      accent="accent"
      emptyMessage={c.noChaosMessage}
      items={chaosItems}
    />
    <SectionGrid
      title={c.recentNotesTitle}
      viewAllHref={`${basePath}/garden/notes/`}
      viewAllLabel={c.viewAll}
      columns={3}
      accent="brand"
      emptyMessage={c.noNotesMessage}
      items={noteItems}
    />
  </div>
</div>

<style>
  .home-reading { letter-spacing: 0; }
  .home-reading :global(section > div:first-child) {
    align-items: baseline;
    flex-wrap: wrap;
    padding-bottom: 1rem;
    margin-bottom: 0;
    border-bottom: 1px solid theme('colors.surface.200');
  }
  .home-reading :global(h2) { font-size: 1.25rem; line-height: 1.5; letter-spacing: 0; }
  .home-reading :global(h2 > span[aria-hidden]) { display: none; }
  .home-reading :global(article) {
    border: 0;
    border-bottom: 1px solid theme('colors.surface.200');
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 1.5rem 0;
    transform: none;
  }
  .home-reading :global(article > span[aria-hidden]) { display: none; }
  .home-reading :global(article h3) { line-height: 1.55; text-wrap: pretty; overflow-wrap: anywhere; }
  .home-reading :global(article p) { line-height: 1.8; margin-bottom: 1rem; color: theme('colors.zinc.600'); }
  .home-reading :global(article > div) { color: theme('colors.zinc.600'); }
  :global(.dark) .home-reading :global(article p),
  :global(.dark) .home-reading :global(article > div) { color: theme('colors.zinc.400'); }
  .home-reading :global(article time > span) { display: none; }
  .home-reading :global(section > .grid) { row-gap: 0; column-gap: 2rem; }
  .home-reading :global(a:focus-visible) { outline: 2px solid theme('colors.accent.600'); outline-offset: 4px; }
  :global(.dark) .home-reading :global(article),
  :global(.dark) .home-reading :global(section > div:first-child) { border-color: theme('colors.surface.700'); }
  @media (min-width: 1024px) {
    .reading-sidebar { border-left: 1px solid theme('colors.surface.200'); padding-left: 2rem; }
    :global(.dark) .reading-sidebar { border-color: theme('colors.surface.700'); }
  }
</style>
