---
import type { Language } from '../../utils/i18n';
import { homeContent } from '../../utils/homeContent';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const c = homeContent[lang];
const basePath = lang === 'zh' ? '/cn' : lang === 'ja' ? '/ja' : '';
const entries = [
  { href: `${basePath}/projects/`, title: c.projectsTitle, desc: c.projectsDesc },
  { href: `${basePath}/visuals/`, title: c.visualsTitle, desc: c.visualsDesc },
  { href: `${basePath}/blog/`, title: c.blogTitle, desc: c.blogDesc },
  { href: `${basePath}/garden/meditations/`, title: c.meditationsTitle, desc: c.meditationsDesc },
  { href: `${basePath}/garden/talks/`, title: c.talksTitle, desc: c.talksDesc },
];
---

<section class="home-hero mx-auto max-w-6xl px-4" data-hero>
  <div class="hero-intro">
    <img class="hero-avatar" src="/assets/avatar.png" alt="" width="72" height="72" />
    <h1 data-hero-title class="font-display font-bold text-surface-950 dark:text-white">{c.title}</h1>
    <p data-hero-kicker class="hero-role text-teal-700 dark:text-accent-400">{c.kicker}</p>
    <p data-hero-sub class="hero-description text-zinc-600 dark:text-surface-300">{c.subtitle}</p>
  </div>

  <div class="hero-entries border-surface-200 dark:border-surface-700" data-home-entries>
    {entries.map((entry) => (
      <a href={entry.href} class="hero-entry group border-surface-200 dark:border-surface-700">
        <span class="font-display text-base font-semibold text-surface-900 group-hover:text-teal-700 dark:text-white dark:group-hover:text-accent-400">
          {entry.title}
        </span>
        <span class="entry-description text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{entry.desc}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .home-hero { padding-top: 2rem; padding-bottom: 3rem; letter-spacing: 0; }
  .hero-intro { max-width: 54rem; }
  .hero-avatar { border-radius: 8px; margin-bottom: 1.5rem; object-fit: cover; }
  h1 { font-size: 3rem; line-height: 1.18; letter-spacing: 0; overflow-wrap: anywhere; text-wrap: balance; }
  .hero-role { margin-top: 1rem; font-size: 0.875rem; font-weight: 600; }
  .hero-description { max-width: 65ch; margin-top: 0.75rem; line-height: 1.8; font-size: 1.125rem; }
  .hero-entries { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top-width: 1px; border-bottom-width: 1px; margin-top: 2.5rem; }
  .hero-entry { padding: 1.25rem 1rem; min-width: 0; transition: background-color 160ms ease; }
  .hero-entry:first-child { padding-left: 0; }
  .hero-entry + .hero-entry { border-left-width: 1px; }
  .hero-entry:hover { background-color: rgb(20 184 166 / 0.06); }
  .hero-entry:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .entry-description { display: block; margin-top: 0.5rem; overflow-wrap: anywhere; }
  @media (max-width: 767px) {
    .home-hero { padding-top: 1rem; padding-bottom: 2rem; }
    h1 { font-size: 2rem; }
    .hero-avatar { width: 56px; height: 56px; margin-bottom: 1rem; }
    .hero-description { font-size: 1rem; }
    .hero-entries { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; }
    .hero-entry { padding: 0.75rem; }
    .hero-entry:nth-child(odd) { padding-left: 0; border-left: 0; }
    .hero-entry:nth-child(n + 3) { border-top-width: 1px; }
    .hero-entry:last-child { grid-column: 1 / -1; }
    .entry-description { font-size: 0.75rem; margin-top: 0.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-entry { transition: none; }
  }
</style>
