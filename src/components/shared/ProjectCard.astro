---
import type { Language } from '../../utils/i18n';
import type { Project } from '../../utils/projectsData';

interface Props {
  project: Project;
  lang: Language;
  reveal?: boolean;
}
const { project, lang, reveal = true } = Astro.props;
const p = project;

const accentByType: Record<string, string> = {
  project: 'brand',
  paper: 'ink',
  tool: 'accent',
  app: 'brand',
  list: 'accent',
};
const accent = accentByType[p.type] ?? 'brand';

const bar: Record<string, string> = {
  brand: 'bg-brand-gradient',
  ink: 'bg-ink-500',
  accent: 'bg-accent-500',
};
const chip: Record<string, string> = {
  brand: 'bg-brand-500/10 text-brand-600 dark:text-brand-300',
  ink: 'bg-ink-500/10 text-ink-600 dark:text-ink-400',
  accent: 'bg-accent-500/10 text-accent-600 dark:text-accent-400',
};

const statusLabel: Record<string, Record<Language, string>> = {
  active: { en: 'Active', zh: '活跃', ja: '活発' },
  alpha: { en: 'Alpha', zh: 'Alpha', ja: 'Alpha' },
  beta: { en: 'Beta', zh: 'Beta', ja: 'Beta' },
  wip: { en: 'WIP', zh: '进行中', ja: '進行中' },
  archived: { en: 'Archived', zh: '已归档', ja: 'アーカイブ' },
};

const primary = p.github || p.demo || p.paper || '#';
const description = p.desc[lang] ?? p.desc.en;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border border-surface-200/80 dark:border-surface-800 bg-white dark:bg-surface-900 p-6 shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-card-hover',
    reveal && 'reveal-init',
  ]}
>
  <div class="mb-3 flex items-center gap-2">
    <span class:list={['rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide', chip[accent]]}>
      {p.type}
    </span>
    {p.venue && (
      <span class="rounded-full bg-ink-500/10 px-2.5 py-1 text-[11px] font-medium text-ink-600 dark:text-ink-400">{p.venue}</span>
    )}
    {p.status && (
      <span class="rounded-full border border-surface-200 dark:border-surface-700 px-2.5 py-1 text-[11px] font-medium text-surface-500 dark:text-surface-400">
        {statusLabel[p.status]?.[lang] ?? p.status}
      </span>
    )}
    {p.featured && <span class="ml-auto text-ink-400" title="Featured">★</span>}
  </div>

  <a href={primary} target="_blank" rel="noopener" class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded">
    <h3 class="font-display text-xl font-bold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors">
      {p.title}
    </h3>
  </a>

  <p class="mt-2 flex-grow text-sm leading-relaxed text-surface-600 dark:text-surface-400">{description}</p>

  {p.techStack && p.techStack.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {p.techStack.map((t) => (
        <span class="rounded-md bg-surface-100 dark:bg-surface-800 px-2 py-0.5 text-[11px] font-medium text-surface-600 dark:text-surface-300">{t}</span>
      ))}
    </div>
  )}

  <div class="mt-5 flex items-center justify-between border-t border-surface-100 dark:border-surface-800 pt-4">
    <div class="flex items-center gap-3 text-xs text-surface-500 dark:text-surface-400">
      {p.language && (
        <span class="inline-flex items-center gap-1">
          <span class="h-2 w-2 rounded-full bg-brand-400"></span>{p.language}
        </span>
      )}
      {typeof p.stars === 'number' && <span class="inline-flex items-center gap-1">★ {p.stars}</span>}
      {typeof p.forks === 'number' && <span class="inline-flex items-center gap-1">⑂ {p.forks}</span>}
    </div>

    <div class="flex items-center gap-2">
      {p.github && (
        <a href={p.github} target="_blank" rel="noopener" aria-label="GitHub" class="text-surface-400 hover:text-surface-900 dark:hover:text-white transition-colors">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
        </a>
      )}
      {p.demo && (
        <a href={p.demo} target="_blank" rel="noopener" aria-label="Live demo" class="text-surface-400 hover:text-brand-600 dark:hover:text-brand-300 transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-7.5 3 9-9m0 0h-4.5m4.5 0v4.5"/></svg>
        </a>
      )}
      {p.paper && (
        <a href={p.paper} target="_blank" rel="noopener" aria-label="Paper" class="text-surface-400 hover:text-ink-600 dark:hover:text-ink-400 transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z"/></svg>
        </a>
      )}
    </div>
  </div>

  <span class:list={['pointer-events-none absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 transition-transform duration-300 ease-out-expo group-hover:scale-x-100', bar[accent]]} aria-hidden="true"></span>
</article>
