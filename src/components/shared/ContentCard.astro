---
// Generic content card used across the homepage and all listing pages.
// Replaces the repeated inline <article class="bg-white dark:bg-gray-800 ..."> blocks.
export interface CardBadge {
  icon?: string;
  label: string;
}

interface Props {
  href: string;
  title: string;
  description?: string;
  dateISO?: string;
  dateLabel?: string;
  tags?: string[];
  tagBasePath?: string; // e.g. "/cn/tags"
  tagCounts?: Record<string, number>; // only show tags with count >= 2
  maxTags?: number;
  badges?: CardBadge[];
  accent?: 'brand' | 'ink' | 'accent';
  reveal?: boolean;
  class?: string;
}

const {
  href,
  title,
  description,
  dateISO,
  dateLabel,
  tags = [],
  tagBasePath,
  tagCounts,
  maxTags = 3,
  badges = [],
  accent = 'brand',
  reveal = true,
  class: className = '',
} = Astro.props;

const shownTags = (tags || [])
  .filter((tag) => !tagCounts || (tagCounts[tag] ?? 0) >= 2)
  .slice(0, maxTags);

const accentBar: Record<string, string> = {
  brand: 'bg-brand-gradient',
  ink: 'bg-ink-500',
  accent: 'bg-accent-500',
};
const hoverTitle: Record<string, string> = {
  brand: 'group-hover:text-brand-600 dark:group-hover:text-brand-300',
  ink: 'group-hover:text-ink-600 dark:group-hover:text-ink-400',
  accent: 'group-hover:text-accent-600 dark:group-hover:text-accent-400',
};
---

<article
  class:list={[
    'group relative overflow-hidden rounded-2xl border border-surface-200/80 dark:border-surface-800 bg-white dark:bg-surface-900 p-5 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1',
    reveal && 'reveal-init',
    className,
  ]}
>
  <a href={href} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-lg">
    <h3 class:list={['font-display text-lg font-semibold leading-snug text-surface-900 dark:text-white mb-2 transition-colors', hoverTitle[accent]]}>
      {title}
    </h3>
    {description && (
      <p class="text-sm text-surface-600 dark:text-surface-400 leading-relaxed line-clamp-2 mb-3">{description}</p>
    )}
  </a>

  {(dateLabel || badges.length > 0 || shownTags.length > 0) && (
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-surface-500 dark:text-surface-400">
      {dateLabel && (
        <time datetime={dateISO}>
          <span class="mr-1" aria-hidden="true">📅</span>{dateLabel}
        </time>
      )}
      {badges.map((b) => (
        <span class="inline-flex items-center">
          {b.icon && <span class="mr-1" aria-hidden="true">{b.icon}</span>}{b.label}
        </span>
      ))}
      {shownTags.length > 0 && tagBasePath && (
        <span class="inline-flex flex-wrap gap-x-2">
          {shownTags.map((tag) => (
            <a href={`${tagBasePath}/${tag}/`} class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors">#{tag}</a>
          ))}
        </span>
      )}
    </div>
  )}

  <span
    class:list={['pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 transition-transform duration-300 ease-out-expo group-hover:scale-x-100', accentBar[accent]]}
    aria-hidden="true"
  ></span>
</article>
