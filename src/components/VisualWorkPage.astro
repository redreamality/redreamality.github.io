---
import Layout from '../layouts/Layout.astro';
import type { Language } from '../utils/i18n';
import type { VisualWork } from '../utils/visuals';
import AirConditionerVisual from './AirConditionerVisual.astro';
import LoopEngineeringVisual from './LoopEngineeringVisual.astro';
import TyphoonVisual from './TyphoonVisual.astro';

interface Props {
  lang: Language;
  work: VisualWork;
}

const { lang, work } = Astro.props;
const localized = work.locales[lang];
const artifactId = localized.artifact;
const artifactComponents = {
  'air-conditioner': AirConditionerVisual,
  'loop-engineering': LoopEngineeringVisual,
  'typhoon': TyphoonVisual,
} as const;
const VisualComponent = artifactId ? artifactComponents[artifactId as keyof typeof artifactComponents] : undefined;

if (!artifactId) throw new Error(`${work.slug} does not publish a ${lang} visual artifact.`);
if (!VisualComponent) throw new Error(`No visual component is registered for artifact ${artifactId}.`);
---

<Layout
  fullWidth
  title={localized.title}
  description={localized.description}
  ogTitle={localized.og.title}
  ogDescription={localized.og.description}
  type="article"
  publishDate={work.publishedAt}
  tags={work.tags}
>
  <VisualComponent {lang} externalResources={work.externalResources} />
</Layout>
