---
/**
 * Project column index page body (/[lang]/projects/<column>/).
 * Shows the column title, intro, a cumulative summary computed from frontmatter,
 * the pinned essay, and all entries newest first with their day numbers.
 */
import Layout from '../../layouts/Layout.astro';
import type { Language } from '../../utils/i18n';
import { getSeriesTitle, type SeriesConfig } from '../../data/series';
import {
  getSeriesDay,
  getSeriesEntryHref,
  getSeriesIndexHref,
  summarizeSeries,
  type SeriesEntryLike,
} from '../../utils/series';

type Entry = SeriesEntryLike & { data: SeriesEntryLike['data'] & { title: string; description: string } };

interface Props {
  lang: Language;
  config: SeriesConfig;
  /** Entries of this series in this locale, newest first. */
  entries: Entry[];
}

const { lang, config, entries } = Astro.props;
const basePath = lang === 'zh' ? '/cn' : lang === 'ja' ? '/ja' : '';
const rssHref = `${getSeriesIndexHref(config.slug, lang)}rss.xml`;
const locale = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';
const title = getSeriesTitle(config, lang);
const description = config.description[lang] ?? config.description.en ?? config.description.zh ?? title;
const seoDescription = config.seoDescription?.[lang] ?? description;
const intro = config.intro[lang] ?? [];
const pinned = config.pinned?.[lang];
const summary = summarizeSeries(entries);
const fmt = (d: Date) => d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });

const strings = {
  zh: {
    kicker: '专栏',
    summary: '累计',
    entries: '已发篇数',
    latestDay: '最新一天',
    span: '时间跨度',
    human: '人工介入次数',
    humanNote: (n: number, total: number) => (n < total ? `（${total} 篇中 ${n} 篇有记录）` : ''),
    pinned: '先读这篇：',
    list: '全部条目',
    day: (n: number) => `第 ${n} 天`,
    rss: 'RSS 订阅',
    back: '返回项目',
  },
  en: {
    kicker: 'Column',
    summary: 'So far',
    entries: 'Entries',
    latestDay: 'Latest day',
    span: 'Span',
    human: 'Human interventions',
    humanNote: (n: number, total: number) => (n < total ? ` (reported in ${n} of ${total})` : ''),
    pinned: 'Start here: ',
    list: 'All entries',
    day: (n: number) => `Day ${n}`,
    rss: 'RSS feed',
    back: 'Back to Projects',
  },
  ja: {
    kicker: 'コラム',
    summary: '累計',
    entries: '記事数',
    latestDay: '最新日',
    span: '期間',
    human: '人の介入回数',
    humanNote: (n: number, total: number) => (n < total ? `（${total} 件中 ${n} 件に記録）` : ''),
    pinned: 'まずはこちら：',
    list: 'すべての記事',
    day: (n: number) => `${n} 日目`,
    rss: 'RSS フィード',
    back: 'プロジェクトへ戻る',
  },
}[lang];
---

<Layout title={title} description={seoDescription}>
  <main class="mx-auto max-w-4xl px-4 py-8" data-series-index={config.slug}>
    <header class="mb-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-medium tracking-wide text-brand-600 dark:text-brand-300">
        <span aria-hidden="true">🌙</span>{strings.kicker}
      </span>
      <h1 class="mt-4 font-display text-4xl md:text-5xl font-extrabold tracking-tight text-surface-900 dark:text-white">{title}</h1>
      {intro.map((p) => (
        <p class="mt-4 text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">{p}</p>
      ))}
    </header>

    <section aria-labelledby="series-summary" class="mb-8 rounded-2xl border border-surface-200 p-5 dark:border-surface-700" data-series-summary>
      <h2 id="series-summary" class="mb-4 text-sm font-semibold uppercase tracking-wide text-surface-500 dark:text-surface-400">{strings.summary}</h2>
      <dl class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div>
          <dt class="text-xs text-surface-500 dark:text-surface-400">{strings.entries}</dt>
          <dd class="text-2xl font-bold text-surface-900 dark:text-white" data-series-count>{summary.entryCount}</dd>
        </div>
        <div>
          <dt class="text-xs text-surface-500 dark:text-surface-400">{strings.latestDay}</dt>
          <dd class="text-2xl font-bold text-surface-900 dark:text-white">{summary.latestDay ?? '—'}</dd>
        </div>
        <div>
          <dt class="text-xs text-surface-500 dark:text-surface-400">{strings.human}</dt>
          <dd class="text-2xl font-bold text-surface-900 dark:text-white" data-series-human>
            {summary.humanInterventionsReported > 0 ? summary.humanInterventions : '—'}
          </dd>
          {summary.humanInterventionsReported > 0 && (
            <dd class="text-xs text-surface-500 dark:text-surface-400">{strings.humanNote(summary.humanInterventionsReported, summary.entryCount)}</dd>
          )}
        </div>
        <div>
          <dt class="text-xs text-surface-500 dark:text-surface-400">{strings.span}</dt>
          <dd class="text-sm font-medium text-surface-900 dark:text-white">
            {summary.firstDate && summary.latestDate ? `${fmt(summary.firstDate)} – ${fmt(summary.latestDate)}` : '—'}
          </dd>
        </div>
      </dl>
    </section>

    {pinned && (
      <p class="mb-8 text-sm text-surface-600 dark:text-surface-300">
        <span class="font-semibold">{strings.pinned}</span>
        <a href={pinned.href} class="text-brand-600 hover:underline dark:text-brand-300">{pinned.title}</a>
      </p>
    )}

    <section aria-labelledby="series-list">
      <h2 id="series-list" class="mb-4 text-xl font-semibold text-surface-900 dark:text-white">{strings.list}</h2>
      <ol class="space-y-4">
        {entries.map((entry) => (
          <li>
            <a
              href={getSeriesEntryHref(config.slug, entry.slug, lang)}
              data-series-entry={entry.slug}
              class="block rounded-lg border border-surface-200 p-4 transition-shadow hover:shadow-md dark:border-surface-700"
            >
              <div class="mb-1 flex flex-wrap items-center gap-3 text-xs text-surface-500 dark:text-surface-400">
                <span class="font-semibold text-brand-600 dark:text-brand-300">{strings.day(getSeriesDay(entry, entries))}</span>
                <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time>
              </div>
              <h3 class="text-base font-semibold text-surface-900 dark:text-white">{entry.data.title}</h3>
              <p class="mt-1 text-sm text-surface-600 dark:text-surface-300">{entry.data.description}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 text-sm">
      <a href={`${basePath}/projects/`} class="text-surface-500 hover:text-brand-600 dark:text-surface-400 dark:hover:text-brand-300">← {strings.back}</a>
      <a href={rssHref} data-series-rss class="text-surface-500 hover:text-brand-600 dark:text-surface-400 dark:hover:text-brand-300">{strings.rss}</a>
    </div>
  </main>
</Layout>
