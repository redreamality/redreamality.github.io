---
/**
 * Chaos digest feed — Hot list + theme-grouped briefs (+ collapsed hourly timeline).
 * Layout (Impeccable Operate+Read): sticky theme rail (lg+) / chip scroller (narrow);
 * main pane Hot → themes. Locale isolation; nofollow externals; same-locale blog links.
 */
import digest from '../../data/chaos-digest.json';
import type { Language } from '../../utils/i18n';
import { toOutboundHref } from '../../utils/outbound';

interface ArchiveItem {
  href: string;
  title: string;
  dateLabel?: string;
}

interface Props {
  lang: Language;
  archive?: ArchiveItem[];
}

const { lang, archive = [] } = Astro.props;

type L = 'zh' | 'en' | 'ja';
const L = (lang === 'zh' || lang === 'ja' ? lang : 'en') as L;

const CJK_RE = /[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/;
function hasCJK(s: string) {
  return CJK_RE.test(s || '');
}
function asciiRatio(s: string) {
  if (!s?.length) return 1;
  return (s.match(/[\x00-\x7F]/g) || []).length / s.length;
}

const copy = {
  zh: {
    title: '底噪',
    subtitle: '选题二次加工：先看各来源摘要，再看编辑判断。未必每条都有长文——摘要与判断够用时再深入。',
    hot: '当前热点',
    timeline: '按小时',
    timelineHint: '次要时间线，默认折叠',
    deepRead: '深入阅读',
    judgment: '判断',
    sources: '来源摘要',
    moreSources: '更多来源',
    empty: '暂无热点选题。',
    archive: '历史深度短文',
    archiveHint: '旧版底噪长文仍可阅读',
    nav: '主题导航',
    status: { published: '已发文', shortlisted: '候选', writing: '撰写中', inbox: '观察' } as Record<string, string>,
    themes: {
      models: '模型发布',
      'coding-tools': '编程工具',
      'agents-oss': '开源 Agent',
      security: '安全',
      research: '研究论文',
      'product-news': '产品动态',
      other: '其他',
    } as Record<string, string>,
    updated: '更新于',
    itemsUnit: '条',
  },
  en: {
    title: 'Chaos',
    subtitle: 'Secondary processing: source briefs first, then editorial judgment. Not every item has a full article — scan briefs and the take, then deep-read when available.',
    hot: 'Hot now',
    timeline: 'By hour',
    timelineHint: 'Secondary timeline, collapsed by default',
    deepRead: 'Deep read',
    judgment: 'Take',
    sources: 'Source briefs',
    moreSources: 'More sources',
    empty: 'No hot topics yet.',
    archive: 'Archive',
    archiveHint: 'Earlier long-form chaos notes',
    nav: 'Theme navigation',
    status: { published: 'Published', shortlisted: 'Shortlisted', writing: 'Writing', inbox: 'Watching' } as Record<string, string>,
    themes: {
      models: 'Models',
      'coding-tools': 'Coding tools',
      'agents-oss': 'Open-source agents',
      security: 'Security',
      research: 'Research',
      'product-news': 'Product news',
      other: 'Other',
    } as Record<string, string>,
    updated: 'Updated',
    itemsUnit: 'items',
  },
  ja: {
    title: 'カオス',
    subtitle: '二次加工：まず各ソースの要約、次に編集判断。すべてに長文があるわけではありません。',
    hot: 'いまのホット',
    timeline: '時間帯',
    timelineHint: '補助タイムライン（既定で折りたたみ）',
    deepRead: '深い読み',
    judgment: '判断',
    sources: 'ソース要約',
    moreSources: '他のソース',
    empty: 'まだホットトピックはありません。',
    archive: 'アーカイブ',
    archiveHint: '以前の長文カオス記事',
    nav: 'テーマナビ',
    status: { published: '公開済', shortlisted: '候補', writing: '執筆中', inbox: '観察' } as Record<string, string>,
    themes: {
      models: 'モデル',
      'coding-tools': 'コーディングツール',
      'agents-oss': 'OSSエージェント',
      security: 'セキュリティ',
      research: '研究',
      'product-news': 'プロダクト',
      other: 'その他',
    } as Record<string, string>,
    updated: '更新',
    itemsUnit: '件',
  },
}[L];

type LocaleBlob = { zh?: string; en?: string; ja?: string };

type SourceBrief = {
  source: string;
  url?: string;
  title?: string;
  brief: LocaleBlob;
};

type DigestItem = {
  id: string;
  theme?: string;
  title: LocaleBlob;
  summary: LocaleBlob;
  judgment?: LocaleBlob;
  sourceBriefs?: SourceBrief[];
  sources: string[];
  score: number;
  status: string;
  externalUrls?: string[];
  blog?: { zh?: string | null; en?: string | null };
};

/**
 * Locale-appropriate title only — no cross-lang fallback of Chinese↔English.
 * zh: CJK title OR mostly-ASCII machine title
 * en/ja: non-empty, not primarily CJK
 */
function localeTitle(item: DigestItem): string | null {
  const t = (item.title?.[L] || '').trim();
  if (!t) return null;
  if (L === 'zh') {
    if (hasCJK(t) || asciiRatio(t) > 0.7) return t;
    return null;
  }
  if (hasCJK(t) && asciiRatio(t) < 0.7) return null;
  return t;
}

function localeText(blob?: LocaleBlob): string {
  const s = (blob?.[L] || '').trim();
  if (!s) return '';
  if (L === 'zh') return s;
  if (hasCJK(s) && asciiRatio(s) < 0.7) return '';
  return s;
}

/** Prefer judgment, fall back to summary (compat). */
function localeJudgment(item: DigestItem): string {
  return localeText(item.judgment) || localeText(item.summary);
}

function localeSourceBrief(sb: SourceBrief): string {
  return localeText(sb.brief);
}

/** Same-locale blog only — do not cross-link zh↔en when both exist. */
function blogHref(item: DigestItem): string | null {
  if (!item.blog) return null;
  if (L === 'zh') return item.blog.zh || null;
  if (L === 'ja') return item.blog.en || null;
  return item.blog.en || null;
}

function primaryExternal(item: DigestItem): string | null {
  return item.externalUrls?.[0] || null;
}

const STATUS_RANK: Record<string, number> = {
  published: 0,
  shortlisted: 1,
  writing: 2,
  inbox: 3,
};

const THEME_ORDER: string[] =
  (digest as { themes?: string[] }).themes || [
    'models',
    'coding-tools',
    'agents-oss',
    'security',
    'research',
    'product-news',
    'other',
  ];

const allRaw: DigestItem[] = digest.hours.flatMap((h) => h.items as DigestItem[]);
const allItems = allRaw.filter((item) => localeTitle(item) !== null);

const hotItems = [...allItems]
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return (STATUS_RANK[a.status] ?? 5) - (STATUS_RANK[b.status] ?? 5);
  })
  .slice(0, 8);

const themeSections = THEME_ORDER.map((themeId) => {
  const items = allItems
    .filter((i) => i.theme === themeId)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return (STATUS_RANK[a.status] ?? 5) - (STATUS_RANK[b.status] ?? 5);
    });
  return { themeId, items };
}).filter((s) => s.items.length > 0);

const hours = digest.hours
  .map((hour) => ({
    ...hour,
    items: hour.items.filter((item) => localeTitle(item as DigestItem) !== null) as DigestItem[],
  }))
  .filter((hour) => hour.items.length > 0);

const hasContent = allItems.length > 0;

function rankLabel(i: number) {
  return String(i + 1).padStart(2, '0');
}

function hourShort(hourStart: string) {
  const m = hourStart.match(/T(\d{2}):/);
  return m ? `${m[1]}:00` : hourStart;
}

function themeLabel(themeId: string) {
  return copy.themes[themeId] || themeId;
}

function allSourceBriefs(item: DigestItem): SourceBrief[] {
  return (item.sourceBriefs || []).filter((sb) => localeSourceBrief(sb));
}

function visibleSourceBriefs(item: DigestItem): { shown: SourceBrief[]; rest: SourceBrief[] } {
  const all = allSourceBriefs(item);
  return { shown: all.slice(0, 2), rest: all.slice(2) };
}

const HOT_ID = 'chaos-hot';
function themeAnchor(themeId: string) {
  return `chaos-theme-${themeId}`;
}

const EXT_REL = 'noopener noreferrer nofollow';
const outboundLang = L;
function extHref(url: string | null | undefined): string | null {
  if (!url) return null;
  return toOutboundHref(url, outboundLang);
}

function statusClass(status: string) {
  if (status === 'published') return 'bg-accent-500/15 text-accent-700 dark:text-accent-300';
  if (status === 'shortlisted') return 'bg-brand-500/10 text-brand-700 dark:text-brand-300';
  if (status === 'writing') return 'bg-ink-500/15 text-ink-600 dark:text-ink-400';
  return 'bg-surface-200/80 dark:bg-surface-700 text-surface-600 dark:text-surface-300';
}

const navLinks = [
  { id: HOT_ID, label: copy.hot, count: hotItems.length },
  ...themeSections.map(({ themeId, items }) => ({
    id: themeAnchor(themeId),
    label: themeLabel(themeId),
    count: items.length,
  })),
];
---

<div class="mx-auto max-w-7xl px-4 sm:px-6">
  <header class="mb-8 max-w-3xl lg:mb-10">
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-surface-900 dark:text-white">{copy.title}</h1>
    <p class="mt-3 text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">{copy.subtitle}</p>
    {digest.updatedAt && (
      <p class="mt-2 text-xs text-surface-500 dark:text-surface-400">
        {copy.updated} · <time datetime={digest.updatedAt}>{digest.updatedAt.replace('T', ' ').replace(/\+08:00$/, ' CST')}</time>
      </p>
    )}
  </header>

  {!hasContent ? (
    <p class="rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 p-10 text-center text-surface-500 dark:text-surface-400">{copy.empty}</p>
  ) : (
    <>
      <!-- Narrow: sticky horizontal theme chips -->
      <nav
        aria-label={copy.nav}
        class="lg:hidden sticky z-20 -mx-4 mb-6 border-b border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-surface-950 px-4 py-2.5 sm:-mx-6 sm:px-6"
        style="top: var(--site-header-height);"
      >
        <ul class="flex gap-2 overflow-x-auto pb-0.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={`#${link.id}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 px-3 py-1.5 text-xs font-medium text-surface-700 dark:text-surface-200 hover:border-accent-500/40 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
              >
                <span>{link.label}</span>
                <span class="tabular-nums text-surface-400 dark:text-surface-500">{link.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="lg:grid lg:grid-cols-[13.5rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[15rem_minmax(0,1fr)] xl:gap-12">
        <!-- lg+: sticky left rail -->
        <aside class="hidden lg:block">
          <nav
            aria-label={copy.nav}
            class="sticky max-h-[calc(100vh-var(--site-header-height)-2rem)] overflow-y-auto pr-1"
            style="top: calc(var(--site-header-height) + 1rem);"
          >
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-surface-400 dark:text-surface-500">{copy.nav}</p>
            <ul class="space-y-0.5 border-l border-surface-200 dark:border-surface-800">
              {navLinks.map((link) => (
                <li>
                  <a
                    href={`#${link.id}`}
                    class="group flex items-center justify-between gap-2 border-l-2 border-transparent -ml-px pl-3 py-1.5 text-sm text-surface-600 dark:text-surface-300 hover:border-accent-500 hover:text-surface-900 dark:hover:text-white transition-colors"
                  >
                    <span class="truncate">{link.label}</span>
                    <span class="shrink-0 tabular-nums text-xs text-surface-400 group-hover:text-accent-600 dark:group-hover:text-accent-400">{link.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <div class="min-w-0 space-y-14 md:space-y-16">
          <!-- Hot band: slightly richer density -->
          <section id={HOT_ID} aria-labelledby="chaos-hot-heading" class="scroll-mt-[calc(var(--site-header-height)+1rem)]">
            <div class="mb-4 flex items-baseline justify-between gap-3">
              <h2 id="chaos-hot-heading" class="font-display text-xl font-bold text-surface-900 dark:text-white">
                {copy.hot}
              </h2>
              <span class="text-xs tabular-nums text-surface-500 dark:text-surface-400">{hotItems.length} {copy.itemsUnit}</span>
            </div>

            <ol class="divide-y divide-surface-200 dark:divide-surface-800 border-y border-surface-200 dark:border-surface-800">
              {hotItems.map((item, i) => {
                const blog = blogHref(item);
                const ext = primaryExternal(item);
                const title = localeTitle(item)!;
                const judgment = localeJudgment(item);
                const statusLabel = copy.status[item.status] || item.status;
                const theme = item.theme;
                const { shown, rest } = visibleSourceBriefs(item);
                return (
                  <li class="group py-4 sm:py-5 first:pt-4 last:pb-4">
                    <div class="flex gap-3 sm:gap-4">
                      <span class="mt-0.5 w-7 shrink-0 font-mono text-sm font-semibold tabular-nums text-accent-600 dark:text-accent-400">{rankLabel(i)}</span>
                      <div class="min-w-0 flex-1 space-y-2">
                        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                          {blog ? (
                            <a href={blog} class="font-display text-[15px] sm:text-base font-semibold leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                              {title}
                            </a>
                          ) : ext ? (
                            <a href={extHref(ext)!} target="_blank" rel={EXT_REL} class="font-display text-[15px] sm:text-base font-semibold leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                              {title}
                            </a>
                          ) : (
                            <span class="font-display text-[15px] sm:text-base font-semibold leading-snug text-surface-900 dark:text-white">{title}</span>
                          )}
                          <span class="inline-flex items-center rounded-md bg-accent-500/10 px-1.5 py-0.5 font-mono text-[11px] font-medium tabular-nums text-accent-700 dark:text-accent-300">
                            {item.score}/5
                          </span>
                          <span class:list={['rounded-full px-2 py-0.5 text-[10px] font-medium', statusClass(item.status)]}>{statusLabel}</span>
                        </div>

                        {judgment && (
                          <p class="text-sm leading-relaxed text-surface-600 dark:text-surface-300 line-clamp-3">
                            <span class="mr-1.5 text-[10px] font-semibold uppercase tracking-wide text-accent-600/80 dark:text-accent-400/80">{copy.judgment}</span>
                            {judgment}
                          </p>
                        )}

                        {shown.length > 0 && (
                          <ul class="space-y-1.5">
                            {shown.map((sb) => {
                              const brief = localeSourceBrief(sb);
                              return (
                                <li class="flex gap-2 text-[12.5px] leading-relaxed text-surface-500 dark:text-surface-400">
                                  {sb.url ? (
                                    <a href={extHref(sb.url)!} target="_blank" rel={EXT_REL} class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide text-surface-600 dark:text-surface-300 hover:border-accent-500/40 hover:text-accent-600 dark:hover:text-accent-400">
                                      {sb.source}
                                    </a>
                                  ) : (
                                    <span class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide text-surface-600 dark:text-surface-300">{sb.source}</span>
                                  )}
                                  <span class="min-w-0 line-clamp-2">{brief}</span>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                        {rest.length > 0 && (
                          <details>
                            <summary class="cursor-pointer list-none text-[11px] font-medium text-surface-500 hover:text-accent-600 dark:text-surface-400 dark:hover:text-accent-400">
                              {copy.moreSources} ({rest.length})
                            </summary>
                            <ul class="mt-1.5 space-y-1.5">
                              {rest.map((sb) => {
                                const brief = localeSourceBrief(sb);
                                return (
                                  <li class="flex gap-2 text-[12.5px] leading-relaxed text-surface-500 dark:text-surface-400">
                                    {sb.url ? (
                                      <a href={extHref(sb.url)!} target="_blank" rel={EXT_REL} class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide">{sb.source}</a>
                                    ) : (
                                      <span class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide">{sb.source}</span>
                                    )}
                                    <span class="min-w-0 line-clamp-2">{brief}</span>
                                  </li>
                                );
                              })}
                            </ul>
                          </details>
                        )}

                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                          {theme && (
                            <a href={`#${themeAnchor(theme)}`} class="rounded-full bg-surface-100 dark:bg-surface-800 px-2 py-0.5 text-[10px] font-medium text-surface-600 dark:text-surface-300 hover:text-accent-700 dark:hover:text-accent-300">
                              {themeLabel(theme)}
                            </a>
                          )}
                          {item.sources.map((s) => (
                            <span class="rounded-full border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-surface-600 dark:text-surface-300">{s}</span>
                          ))}
                          {blog && (
                            <a href={blog} class="ml-auto text-xs font-medium text-accent-600 hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300">
                              {copy.deepRead} →
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>

          <!-- Theme sections: scannable lists -->
          {themeSections.map(({ themeId, items }) => (
            <section
              id={themeAnchor(themeId)}
              aria-labelledby={`chaos-theme-heading-${themeId}`}
              class="scroll-mt-[calc(var(--site-header-height)+1rem)]"
            >
              <div class="mb-3 flex items-baseline justify-between gap-3">
                <h2 id={`chaos-theme-heading-${themeId}`} class="font-display text-lg font-bold text-surface-900 dark:text-white">
                  {themeLabel(themeId)}
                </h2>
                <span class="text-xs tabular-nums text-surface-500 dark:text-surface-400">{items.length} {copy.itemsUnit}</span>
              </div>

              <ul class="divide-y divide-surface-200 dark:divide-surface-800 border-y border-surface-200 dark:border-surface-800">
                {items.map((item) => {
                  const blog = blogHref(item);
                  const ext = primaryExternal(item);
                  const title = localeTitle(item)!;
                  const judgment = localeJudgment(item);
                  const statusLabel = copy.status[item.status] || item.status;
                  const briefs = allSourceBriefs(item);
                  return (
                    <li class="py-3 sm:py-3.5 space-y-1.5">
                      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                        {blog ? (
                          <a href={blog} class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">
                            {title}
                          </a>
                        ) : ext ? (
                          <a href={extHref(ext)!} target="_blank" rel={EXT_REL} class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">
                            {title}
                          </a>
                        ) : (
                          <span class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white">{title}</span>
                        )}
                        <span class="font-mono text-[10px] tabular-nums text-accent-600/90 dark:text-accent-400">{item.score}/5</span>
                        <span class:list={['rounded-full px-1.5 py-px text-[10px] font-medium', statusClass(item.status)]}>{statusLabel}</span>
                        {blog && (
                          <a href={blog} class="ml-auto text-[11px] font-medium text-accent-600 dark:text-accent-400 hover:underline">
                            {copy.deepRead} →
                          </a>
                        )}
                      </div>

                      {judgment && (
                        <p class="text-[13px] leading-relaxed text-surface-600 dark:text-surface-300 line-clamp-1">{judgment}</p>
                      )}

                      {briefs.length > 0 && (
                        <details class="group/src">
                          <summary class="cursor-pointer list-none text-[11px] font-medium text-surface-500 hover:text-accent-600 dark:text-surface-400 dark:hover:text-accent-400">
                            {copy.sources} ({briefs.length})
                          </summary>
                          <ul class="mt-1.5 space-y-1">
                            {briefs.map((sb) => (
                              <li class="flex gap-2 text-[12px] leading-relaxed text-surface-500 dark:text-surface-400">
                                {sb.url ? (
                                  <a href={extHref(sb.url)!} target="_blank" rel={EXT_REL} class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide hover:text-accent-600 dark:hover:text-accent-400">{sb.source}</a>
                                ) : (
                                  <span class="shrink-0 mt-0.5 rounded border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide">{sb.source}</span>
                                )}
                                <span class="min-w-0 line-clamp-2">{localeSourceBrief(sb)}</span>
                              </li>
                            ))}
                          </ul>
                        </details>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}

          <!-- Hourly timeline: collapsed by default -->
          {hours.length > 0 && (
            <details class="group border-t border-dashed border-surface-300 dark:border-surface-700 pt-2">
              <summary class="cursor-pointer list-none py-3 flex items-center justify-between gap-3">
                <span class="font-display text-base font-bold text-surface-800 dark:text-surface-200">
                  {copy.timeline}
                  <span class="ml-2 text-xs font-normal text-surface-500">· {copy.timelineHint}</span>
                </span>
                <span class="text-surface-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>

              <div class="pb-2 space-y-8">
                {hours.map((hour) => (
                  <div>
                    <header class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                      <time datetime={hour.hourStart} class="font-display text-sm font-bold tabular-nums text-surface-900 dark:text-white">
                        {hour.label[L] || hour.label.en}
                      </time>
                      <span class="text-xs text-surface-500 dark:text-surface-400">{hourShort(hour.hourStart)} · {hour.items.length} {copy.itemsUnit}</span>
                    </header>
                    <ul class="divide-y divide-surface-200 dark:divide-surface-800 border-y border-surface-200 dark:border-surface-800">
                      {hour.items.map((item) => {
                        const blog = blogHref(item);
                        const ext = primaryExternal(item);
                        const title = localeTitle(item)!;
                        const judgment = localeJudgment(item);
                        return (
                          <li class="py-2.5">
                            <div class="flex flex-wrap items-baseline gap-x-2">
                              {blog ? (
                                <a href={blog} class="font-medium text-[13px] text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">{title}</a>
                              ) : ext ? (
                                <a href={extHref(ext)!} target="_blank" rel={EXT_REL} class="font-medium text-[13px] text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">{title}</a>
                              ) : (
                                <span class="font-medium text-[13px] text-surface-900 dark:text-white">{title}</span>
                              )}
                              <span class="font-mono text-[10px] tabular-nums text-accent-600/90 dark:text-accent-400">{item.score}/5</span>
                            </div>
                            {judgment && (
                              <p class="mt-0.5 text-[12px] leading-relaxed text-surface-500 dark:text-surface-400 line-clamp-2">{judgment}</p>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    </>
  )}

  <!-- Legacy archive -->
  {archive.length > 0 && (
    <details class="mt-14 group border-t border-dashed border-surface-300 dark:border-surface-700">
      <summary class="cursor-pointer list-none py-4 flex items-center justify-between gap-3 text-sm font-medium text-surface-700 dark:text-surface-300">
        <span>
          <span class="font-display font-semibold text-surface-900 dark:text-white">{copy.archive}</span>
          <span class="ml-2 text-xs font-normal text-surface-500">· {copy.archiveHint} ({archive.length})</span>
        </span>
        <span class="text-surface-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>
      <ul class="border-t border-surface-200 dark:border-surface-800 divide-y divide-surface-100 dark:divide-surface-800">
        {archive.map((a) => (
          <li>
            <a href={a.href} class="flex items-baseline justify-between gap-3 py-3 text-sm hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              <span class="font-medium text-surface-800 dark:text-surface-200">{a.title}</span>
              {a.dateLabel && <time class="shrink-0 text-xs text-surface-500">{a.dateLabel}</time>}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</div>
