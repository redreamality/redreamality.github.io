---
/**
 * Chaos digest feed — aihot.news–inspired hot list + hourly timeline.
 * Primary UX: ranked topics grouped by Asia/Shanghai hour buckets.
 * Legacy long-form chaos posts appear in a collapsible Archive footer.
 */
import digest from '../../data/chaos-digest.json';
import type { Language } from '../../utils/i18n';

interface ArchiveItem {
  href: string;
  title: string;
  dateLabel?: string;
}

interface Props {
  lang: Language;
  archive?: ArchiveItem[];
}

const { lang, archive = [] } = Astro.props;

type L = 'zh' | 'en' | 'ja';
const L = (lang === 'zh' || lang === 'ja' ? lang : 'en') as L;

const copy = {
  zh: {
    kicker: '信号 · 底噪',
    title: '底噪',
    subtitle: '按小时汇总的近期热点选题。未必每条都有长文——先看信号，再决定是否深入。',
    hot: '当前热点',
    timeline: '按小时',
    deepRead: '深入阅读',
    score: '热度',
    empty: '暂无热点选题。',
    archive: '历史深度短文',
    archiveHint: '旧版底噪长文仍可阅读',
    status: { published: '已发文', shortlisted: '候选', writing: '撰写中', inbox: '观察' } as Record<string, string>,
    updated: '更新于',
    itemsUnit: '条',
  },
  en: {
    kicker: 'Signals · Noise',
    title: 'Chaos',
    subtitle: 'Recent hot topics grouped by hour. Not every item has a full article — scan signals first, then deep-read when available.',
    hot: 'Hot now',
    timeline: 'By hour',
    deepRead: 'Deep read',
    score: 'Heat',
    empty: 'No hot topics yet.',
    archive: 'Archive',
    archiveHint: 'Earlier long-form chaos notes',
    status: { published: 'Published', shortlisted: 'Shortlisted', writing: 'Writing', inbox: 'Watching' } as Record<string, string>,
    updated: 'Updated',
    itemsUnit: 'items',
  },
  ja: {
    kicker: 'シグナル · ノイズ',
    title: 'カオス',
    subtitle: '直近のホットトピックを時間帯ごとにまとめます。すべてに長文があるわけではありません。',
    hot: 'いまのホット',
    timeline: '時間帯',
    deepRead: '深い読み',
    score: '熱度',
    empty: 'まだホットトピックはありません。',
    archive: 'アーカイブ',
    archiveHint: '以前の長文カオス記事',
    status: { published: '公開済', shortlisted: '候補', writing: '執筆中', inbox: '観察' } as Record<string, string>,
    updated: '更新',
    itemsUnit: '件',
  },
}[L];

type DigestItem = (typeof digest.hours)[number]['items'][number];

function pickTitle(item: DigestItem) {
  return item.title[L] || item.title.zh || item.title.en;
}
function pickSummary(item: DigestItem) {
  return item.summary[L] || item.summary.zh || item.summary.en || '';
}
function blogHref(item: DigestItem): string | null {
  if (!item.blog) return null;
  if (L === 'zh') return item.blog.zh || item.blog.en || null;
  if (L === 'ja') return item.blog.en || item.blog.zh || null; // JA often falls back to EN blog
  return item.blog.en || item.blog.zh || null;
}
function primaryExternal(item: DigestItem): string | null {
  return item.externalUrls?.[0] || null;
}

/** Flat ranked list for hot section: score desc, then status */
const STATUS_RANK: Record<string, number> = {
  published: 0,
  shortlisted: 1,
  writing: 2,
  inbox: 3,
};
const allItems: DigestItem[] = digest.hours.flatMap((h) => h.items);
const hotItems = [...allItems]
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return (STATUS_RANK[a.status] ?? 5) - (STATUS_RANK[b.status] ?? 5);
  })
  .slice(0, 10);

const hours = digest.hours;
const hasContent = allItems.length > 0;

function rankLabel(i: number) {
  return String(i + 1).padStart(2, '0');
}

function hourShort(hourStart: string) {
  const m = hourStart.match(/T(\d{2}):/);
  return m ? `${m[1]}:00` : hourStart;
}
---

<div class="mx-auto max-w-3xl px-4">
  <header class="mb-10 text-center">
    <span class="inline-flex items-center gap-2 rounded-full border border-accent-500/30 bg-accent-500/10 px-4 py-1.5 text-xs font-medium tracking-wide text-accent-600 dark:text-accent-400">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>{copy.kicker}
    </span>
    <h1 class="mt-5 font-display text-5xl md:text-6xl font-extrabold tracking-tight text-surface-900 dark:text-white">{copy.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">{copy.subtitle}</p>
    {digest.updatedAt && (
      <p class="mt-3 text-xs text-surface-500 dark:text-surface-400">
        {copy.updated} · <time datetime={digest.updatedAt}>{digest.updatedAt.replace('T', ' ').replace(/\+08:00$/, ' CST')}</time>
      </p>
    )}
  </header>

  {!hasContent ? (
    <p class="rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 p-10 text-center text-surface-500 dark:text-surface-400">{copy.empty}</p>
  ) : (
    <div class="space-y-12">
      <!-- Hot list -->
      <section aria-labelledby="chaos-hot-heading">
        <div class="rounded-2xl border border-surface-200 dark:border-surface-800 bg-white dark:bg-surface-900 shadow-card overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-surface-200/80 dark:border-surface-800 px-5 py-3.5">
            <h2 id="chaos-hot-heading" class="flex items-center gap-2 font-display text-lg font-bold text-surface-900 dark:text-white">
              <span class="inline-block h-2 w-2 rounded-full bg-accent-500 shadow-glow-accent" aria-hidden="true"></span>
              {copy.hot}
            </h2>
            <span class="text-xs tabular-nums text-surface-500 dark:text-surface-400">{hotItems.length} {copy.itemsUnit}</span>
          </div>
          <ol class="divide-y divide-surface-100 dark:divide-surface-800">
            {hotItems.map((item, i) => {
              const blog = blogHref(item);
              const ext = primaryExternal(item);
              const title = pickTitle(item);
              const summary = pickSummary(item);
              const statusLabel = copy.status[item.status] || item.status;
              return (
                <li class="group flex gap-3 px-4 py-3.5 sm:px-5 hover:bg-surface-50/80 dark:hover:bg-surface-800/40 transition-colors">
                  <span class="mt-0.5 w-8 shrink-0 font-mono text-sm font-semibold tabular-nums text-accent-600 dark:text-accent-400">{rankLabel(i)}</span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      {blog ? (
                        <a href={blog} class="font-display text-[15px] font-semibold leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                          {title}
                        </a>
                      ) : ext ? (
                        <a href={ext} target="_blank" rel="noopener noreferrer" class="font-display text-[15px] font-semibold leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                          {title}
                        </a>
                      ) : (
                        <span class="font-display text-[15px] font-semibold leading-snug text-surface-900 dark:text-white">{title}</span>
                      )}
                      <span class="inline-flex items-center rounded-md bg-accent-500/10 px-1.5 py-0.5 font-mono text-[11px] font-medium tabular-nums text-accent-700 dark:text-accent-300">
                        {item.score}/5
                      </span>
                    </div>
                    {summary && (
                      <p class="mt-1 text-sm leading-relaxed text-surface-500 dark:text-surface-400 line-clamp-1">{summary}</p>
                    )}
                    <div class="mt-2 flex flex-wrap items-center gap-1.5">
                      {item.sources.map((s) => (
                        <span class="rounded-full border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-surface-600 dark:text-surface-300">{s}</span>
                      ))}
                      <span class:list={[
                        'rounded-full px-2 py-0.5 text-[10px] font-medium',
                        item.status === 'published' && 'bg-accent-500/15 text-accent-700 dark:text-accent-300',
                        item.status === 'shortlisted' && 'bg-brand-500/10 text-brand-700 dark:text-brand-300',
                        item.status === 'writing' && 'bg-ink-500/15 text-ink-600 dark:text-ink-400',
                        (item.status === 'inbox' || !['published','shortlisted','writing'].includes(item.status)) && 'bg-surface-200/80 dark:bg-surface-700 text-surface-600 dark:text-surface-300',
                      ]}>{statusLabel}</span>
                      {blog && (
                        <a href={blog} class="ml-auto text-xs font-medium text-accent-600 hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300">
                          {copy.deepRead} →
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </section>

      <!-- Hourly timeline -->
      <section aria-labelledby="chaos-timeline-heading">
        <h2 id="chaos-timeline-heading" class="mb-6 flex items-center gap-2 font-display text-xl font-bold text-surface-900 dark:text-white">
          <span class="inline-block h-6 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
          {copy.timeline}
        </h2>

        <div class="relative pl-0 sm:pl-2">
          <!-- vertical line -->
          <div class="pointer-events-none absolute left-[11px] top-2 bottom-2 hidden w-px bg-surface-200 dark:bg-surface-700 sm:block" aria-hidden="true"></div>

          <div class="space-y-8">
            {hours.map((hour) => (
              <div class="relative sm:pl-10">
                <!-- teal dot -->
                <div class="absolute left-0 top-3 hidden h-[22px] w-[22px] items-center justify-center sm:flex" aria-hidden="true">
                  <span class="h-3 w-3 rounded-full border-2 border-accent-500 bg-white dark:bg-surface-900 shadow-[0_0_0_4px_rgba(20,184,166,0.15)]"></span>
                </div>

                <div class="rounded-2xl border border-surface-200 dark:border-surface-800 bg-white dark:bg-surface-900 shadow-card overflow-hidden">
                  <header class="sticky top-0 z-10 flex flex-wrap items-center justify-between gap-2 border-b border-surface-200/80 dark:border-surface-800 bg-white/95 dark:bg-surface-900/95 backdrop-blur px-4 py-3 sm:px-5">
                    <div class="flex items-baseline gap-2">
                      <time datetime={hour.hourStart} class="font-display text-base font-bold tabular-nums text-surface-900 dark:text-white">
                        {hour.label[L] || hour.label.zh}
                      </time>
                      <span class="text-xs text-surface-500 dark:text-surface-400">· {hourShort(hour.hourStart)} · {hour.items.length} {copy.itemsUnit}</span>
                    </div>
                  </header>

                  <ul class="divide-y divide-surface-100 dark:divide-surface-800">
                    {hour.items.map((item) => {
                      const blog = blogHref(item);
                      const ext = primaryExternal(item);
                      const title = pickTitle(item);
                      const summary = pickSummary(item);
                      const statusLabel = copy.status[item.status] || item.status;
                      return (
                        <li class="px-4 py-3 sm:px-5 hover:bg-surface-50/70 dark:hover:bg-surface-800/30 transition-colors">
                          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                            {blog ? (
                              <a href={blog} class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">
                                {title}
                              </a>
                            ) : ext ? (
                              <a href={ext} target="_blank" rel="noopener noreferrer" class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400">
                                {title}
                              </a>
                            ) : (
                              <span class="font-semibold text-[14px] leading-snug text-surface-900 dark:text-white">{title}</span>
                            )}
                            <span class="font-mono text-[10px] tabular-nums text-accent-600/90 dark:text-accent-400">{item.score}/5</span>
                          </div>
                          {summary && (
                            <p class="mt-0.5 text-[13px] leading-relaxed text-surface-500 dark:text-surface-400 line-clamp-1">{summary}</p>
                          )}
                          <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                            {item.sources.map((s) => (
                              <span class="rounded-full border border-surface-200 dark:border-surface-700 px-1.5 py-px text-[10px] uppercase tracking-wide text-surface-500 dark:text-surface-400">{s}</span>
                            ))}
                            <span class:list={[
                              'rounded-full px-1.5 py-px text-[10px] font-medium',
                              item.status === 'published' && 'bg-accent-500/15 text-accent-700 dark:text-accent-300',
                              item.status === 'shortlisted' && 'bg-brand-500/10 text-brand-700 dark:text-brand-300',
                              item.status === 'writing' && 'bg-ink-500/15 text-ink-600 dark:text-ink-400',
                              (item.status === 'inbox' || !['published','shortlisted','writing'].includes(item.status)) && 'bg-surface-100 dark:bg-surface-800 text-surface-500',
                            ]}>{statusLabel}</span>
                            {blog && (
                              <a href={blog} class="ml-auto text-[11px] font-medium text-accent-600 dark:text-accent-400 hover:underline">
                                {copy.deepRead} →
                              </a>
                            )}
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  )}

  <!-- Legacy archive -->
  {archive.length > 0 && (
    <details class="mt-14 group rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 bg-surface-50/50 dark:bg-surface-900/40">
      <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-3 text-sm font-medium text-surface-700 dark:text-surface-300">
        <span>
          <span class="font-display font-semibold text-surface-900 dark:text-white">{copy.archive}</span>
          <span class="ml-2 text-xs font-normal text-surface-500">· {copy.archiveHint} ({archive.length})</span>
        </span>
        <span class="text-surface-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>
      <ul class="border-t border-surface-200 dark:border-surface-800 divide-y divide-surface-100 dark:divide-surface-800">
        {archive.map((a) => (
          <li>
            <a href={a.href} class="flex items-baseline justify-between gap-3 px-5 py-3 text-sm hover:bg-white dark:hover:bg-surface-800/50 transition-colors">
              <span class="font-medium text-surface-800 dark:text-surface-200">{a.title}</span>
              {a.dateLabel && <time class="shrink-0 text-xs text-surface-500">{a.dateLabel}</time>}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</div>
