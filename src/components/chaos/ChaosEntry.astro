---
import TableOfContents from '../TableOfContents.astro';
import type { Language } from '../../utils/i18n';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type RelatedItem = {
  href: string;
  title: string;
  description?: string;
  date?: Date;
};

type Props = {
  lang: Language;
  title: string;
  description?: string;
  pubDate: Date;
  author: string;
  tags?: string[];
  headings: Heading[];
  relatedItems: RelatedItem[];
};

const {
  lang,
  title,
  description,
  pubDate,
  author,
  tags = [],
  headings,
  relatedItems,
} = Astro.props;

const copy = {
  en: {
    publishedOn: 'Published',
    by: 'by',
    backToChaos: 'Back to Chaos',
    relatedTitle: 'Related',
    chaosIndexLabel: 'Chaos',
    locale: 'en-US',
  },
  zh: {
    publishedOn: '发布于',
    by: '作者',
    backToChaos: '返回底噪',
    relatedTitle: '相关底噪',
    chaosIndexLabel: '底噪',
    locale: 'zh-CN',
  },
  ja: {
    publishedOn: '公開日',
    by: '著者',
    backToChaos: 'カオスへ戻る',
    relatedTitle: '関連',
    chaosIndexLabel: 'カオス',
    locale: 'ja-JP',
  },
}[lang];

const indexHref =
  lang === 'zh' ? '/cn/garden/chaos/' : lang === 'ja' ? '/ja/garden/chaos/' : '/garden/chaos/';

const formattedDate = pubDate.toLocaleDateString(copy.locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const hasToc = headings.length > 0;
const hasTags = tags.length > 0;
const hasRelated = relatedItems.length > 0;
---

<main class="w-full">
  {hasToc && <TableOfContents headings={headings} />}

  <article class="mx-auto max-w-[70ch]">
    <header class="mb-10 motion-safe:opacity-0 motion-safe:animate-fade-up motion-safe:[animation-timing-function:cubic-bezier(0.16,1,0.3,1)]">
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-balance text-surface-900 dark:text-surface-50">
        {title}
      </h1>

      {description && (
        <p class="mt-4 text-lg leading-relaxed text-surface-700 dark:text-surface-300">
          {description}
        </p>
      )}

      <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-surface-700 dark:text-surface-300">
        <time datetime={pubDate.toISOString()}>
          <span class="sr-only">{copy.publishedOn} </span>
          {formattedDate}
        </time>
        <span aria-hidden="true" class="text-surface-300 dark:text-surface-700">·</span>
        <span>
          <span class="sr-only">{copy.by} </span>
          {author}
        </span>
        <span aria-hidden="true" class="text-surface-300 dark:text-surface-700">·</span>
        <a
          href={indexHref}
          class="font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50 dark:focus-visible:ring-offset-surface-950 rounded-sm transition-colors duration-200 ease-out-expo"
        >
          {copy.chaosIndexLabel}
        </a>
      </p>

      {hasTags && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <span class="inline-flex items-center rounded-full bg-surface-100 px-2.5 py-0.5 text-xs font-medium text-surface-700 dark:bg-surface-800 dark:text-surface-300">
                {tag}
              </span>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="chaos-entry-prose prose prose-lg max-w-none">
      <slot />
    </div>

    <footer class="mt-16 pt-10 border-t border-surface-200 dark:border-surface-800">
      {hasRelated && (
        <section aria-labelledby="chaos-related-heading" class="mb-12">
          <h2
            id="chaos-related-heading"
            class="font-display text-xl font-semibold tracking-tight text-surface-900 dark:text-surface-50 mb-5"
          >
            {copy.relatedTitle}
          </h2>
          <ul class="space-y-2" role="list">
            {relatedItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group block rounded-2xl border border-surface-200 dark:border-surface-800 px-5 py-4 transition-[border-color,background-color] duration-200 ease-out-expo hover:border-brand-400 dark:hover:border-brand-400 hover:bg-surface-100/60 dark:hover:bg-surface-900/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50 dark:focus-visible:ring-offset-surface-950"
                >
                  <span class="block font-medium text-surface-900 dark:text-surface-50 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors duration-200 ease-out-expo">
                    {item.title}
                  </span>
                  {item.date && (
                    <time
                      datetime={item.date.toISOString()}
                      class="mt-1 block text-xs text-surface-700 dark:text-surface-300"
                    >
                      {item.date.toLocaleDateString(copy.locale, {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                  {item.description && (
                    <span class="mt-1.5 block text-sm leading-relaxed text-surface-700 dark:text-surface-300 line-clamp-2">
                      {item.description}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <a
        href={indexHref}
        class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50 dark:focus-visible:ring-offset-surface-950 rounded-sm transition-colors duration-200 ease-out-expo"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M10 3 5 8l5 5"
          />
        </svg>
        {copy.backToChaos}
      </a>
    </footer>
  </article>
</main>

<style>
  .chaos-entry-prose :where(h2, h3, h4, h5, h6) {
    font-family: theme('fontFamily.display');
  }

  .chaos-entry-prose :where(h2, h3, h4, h5, h6):not(:first-child) {
    margin-top: 2.25em;
  }

  .chaos-entry-prose :where(p, li) {
    color: theme('colors.surface.800');
  }

  :global(.dark) .chaos-entry-prose :where(p, li) {
    color: theme('colors.surface.100');
  }

  .chaos-entry-prose :where(a):not(:where(.not-prose, .not-prose *)) {
    color: theme('colors.brand.600');
  }

  :global(.dark) .chaos-entry-prose :where(a):not(:where(.not-prose, .not-prose *)) {
    color: theme('colors.brand.400');
  }

  .chaos-entry-prose :where(p) {
    font-size: 1.125rem;
    line-height: 1.75;
  }
</style>
