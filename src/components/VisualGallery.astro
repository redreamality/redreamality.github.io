---
import type { Language } from '../utils/i18n';
import { getVisualGallery } from '../utils/visuals';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const works = getVisualGallery(lang);
const locale = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';

const copy = {
  en: {
    title: 'Visuals',
    eyebrow: 'Interactive stories and visual systems',
    introduction: 'A curated collection of visual explanations, simulations, and standalone interactive works.',
    open: 'Open experience',
    openLanguage: 'Open {language} version',
    typeStandalone: 'Visual story',
    typeExplainer: 'Interactive explainer',
    languages: 'Languages: {language}',
    availableOnly: '{language} only',
    missingMessage: '{title} is not available in this language. Available in {language}.',
    languageNames: { en: 'English', zh: 'Chinese', ja: 'Japanese' },
  },
  zh: {
    title: '可视化',
    eyebrow: '交互叙事与视觉系统',
    introduction: '精选可视化解释、模拟器与独立交互作品。',
    open: '打开体验',
    openLanguage: '打开{language}版本',
    typeStandalone: '视觉故事',
    typeExplainer: '交互图解',
    languages: '语言：{language}',
    availableOnly: '仅{language}',
    missingMessage: '{title}尚未提供当前语言版本，可使用{language}版本。',
    languageNames: { en: '英文', zh: '中文', ja: '日文' },
  },
  ja: {
    title: 'ビジュアル',
    eyebrow: 'インタラクティブな物語と視覚システム',
    introduction: '視覚的な解説、シミュレーション、独立したインタラクティブ作品を集めました。',
    open: '体験を開く',
    openLanguage: '{language}版を開く',
    typeStandalone: 'ビジュアルストーリー',
    typeExplainer: 'インタラクティブ解説',
    languages: '言語：{language}',
    availableOnly: '{language}のみ',
    missingMessage: '{title}は現在の言語では利用できません。{language}版を利用できます。',
    languageNames: { en: '英語', zh: '中国語', ja: '日本語' },
  },
} as const;

const c = copy[lang];
const languageList = (languages: Language[]) => languages.map((item) => c.languageNames[item]).join(' / ');
const bannerWorks = Object.fromEntries(works.filter((work) => !work.hasCurrentArtifact).map((work) => {
  const availableLabel = languageList(work.availableLanguages);
  return [work.slug, {
    title: work.title,
    message: c.missingMessage
      .replace('{title}', work.title)
      .replace('{language}', availableLabel),
    href: work.href,
    openLabel: c.openLanguage.replace('{language}', availableLabel),
  }];
}));
---

<section class="mx-auto max-w-6xl px-4 py-8 md:py-14">
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-300">{c.eyebrow}</p>
    <h1 class="mt-4 font-display text-5xl font-extrabold tracking-tight text-surface-950 dark:text-white md:text-7xl">{c.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-surface-600 dark:text-surface-300">{c.introduction}</p>
  </header>

  <aside
    hidden
    role="alert"
    tabindex="-1"
    data-missing-visual-banner
    class="mt-8 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-amber-950 shadow-sm dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100"
  >
    <p data-missing-visual-message class="font-medium"></p>
    <a data-missing-visual-link class="mt-3 inline-flex font-semibold text-brand-700 underline underline-offset-4 dark:text-brand-300"></a>
  </aside>

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {works.map((work) => {
      const availableLabel = languageList(work.availableLanguages);
      const onlyLabel = c.availableOnly.replace('{language}', availableLabel);
      const languagesLabel = c.languages.replace('{language}', availableLabel);
      const openLabel = work.hasCurrentArtifact
        ? c.open
        : c.openLanguage.replace('{language}', availableLabel);
      const isAirConditioner = work.cover === 'air-conditioner';
      const isLoopEngineering = work.cover === 'loop-engineering';
      const isPriceVolume = work.cover === 'price-volume';
      const isTyphoon = work.cover === 'typhoon';
      const isEnsoFoodPrices = work.cover === 'enso-food-prices';
      const isPrisonersDilemma = work.cover === 'prisoners-dilemma';
      const isButterflyEffect = work.cover === 'butterfly-effect';
      const isInflationPurchasingPower = work.cover === 'inflation-purchasing-power';
      const isCompoundInterest = work.cover === 'compound-interest';
      const isBayesLabResult = work.cover === 'bayes-lab-result';
      const isNormalDistribution = work.cover === 'normal-distribution';

      return (
        <article id={work.slug} data-visual-card={work.slug} class="group overflow-hidden rounded-3xl border border-surface-200/80 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover dark:border-surface-800 dark:bg-surface-900">
          <div class="relative h-56 overflow-hidden bg-gradient-to-br from-slate-950 via-cyan-900 to-teal-500">
            <div class="absolute inset-0 opacity-70 [background-image:radial-gradient(circle_at_20%_20%,rgba(255,255,255,.5)_0_2px,transparent_3px),radial-gradient(circle_at_75%_65%,rgba(255,255,255,.35)_0_3px,transparent_4px)] [background-size:70px_70px,110px_110px]"></div>
            {isAirConditioner && (
              <>
                <div class="absolute left-[10%] top-[24%] h-24 w-32 rounded-2xl border border-cyan-100/35 bg-cyan-100/10 shadow-[0_0_35px_rgba(103,232,249,.18)] backdrop-blur-sm"></div>
                <div class="absolute right-[10%] top-[24%] h-24 w-32 rounded-2xl border border-amber-100/35 bg-amber-100/10 shadow-[0_0_35px_rgba(251,191,36,.18)] backdrop-blur-sm"></div>
                <div class="absolute left-[18%] top-[42%] h-10 w-10 rounded-full border-4 border-cyan-100/50"></div>
                <div class="absolute right-[18%] top-[42%] h-10 w-10 rounded-full border-4 border-amber-100/50 motion-safe:animate-[spin_3s_linear_infinite]"></div>
                <div class="absolute left-[34%] top-[34%] h-px w-[32%] bg-gradient-to-r from-cyan-200/70 via-white/70 to-amber-200/70"></div>
                <div class="absolute left-[34%] top-[62%] h-px w-[32%] bg-gradient-to-l from-cyan-200/70 via-white/70 to-amber-200/70"></div>
                <div class="absolute left-[31%] top-[29%] h-[39%] w-[38%] rounded-[50%] border border-dashed border-white/30 motion-safe:animate-[spin_14s_linear_infinite]"></div>
              </>
            )}
            {isLoopEngineering && (
              <>
                <div class="absolute inset-7 rounded-3xl border border-white/15 bg-black/15 backdrop-blur-sm"></div>
                <div class="absolute left-[14%] top-[22%] h-12 w-20 rounded-xl border border-cyan-100/40 bg-cyan-100/10"></div>
                <div class="absolute right-[14%] top-[22%] h-12 w-20 rounded-xl border border-indigo-100/40 bg-indigo-100/10"></div>
                <div class="absolute bottom-[20%] left-1/2 h-12 w-20 -translate-x-1/2 rounded-xl border border-teal-100/40 bg-teal-100/10"></div>
                <div class="absolute left-[24%] top-[46%] h-px w-[52%] bg-white/35"></div>
                <div class="absolute left-1/2 top-[38%] h-[31%] w-px bg-white/35"></div>
                <div class="absolute left-[17%] top-[15%] h-[67%] w-[66%] rounded-[50%] border border-dashed border-white/25 motion-safe:animate-[spin_18s_linear_infinite]"></div>
              </>
            )}
            {isPriceVolume && (
              <>
                <div class="absolute inset-7 rounded-3xl border border-white/15 bg-slate-950/35 backdrop-blur-sm"></div>
                <div class="absolute bottom-[24%] left-[15%] flex h-[43%] w-[70%] items-end gap-2">
                  <div class="h-[32%] flex-1 rounded-t bg-amber-300/45"></div>
                  <div class="h-[48%] flex-1 rounded-t bg-amber-300/55"></div>
                  <div class="h-[40%] flex-1 rounded-t bg-amber-300/45"></div>
                  <div class="h-[72%] flex-1 rounded-t bg-amber-300/75"></div>
                  <div class="h-[58%] flex-1 rounded-t bg-amber-300/55"></div>
                  <div class="h-[82%] flex-1 rounded-t bg-amber-300/70"></div>
                </div>
                <div class="absolute left-[14%] top-[33%] h-[2px] w-[72%] -rotate-6 bg-cyan-200/80 shadow-[0_0_12px_rgba(165,243,252,.6)]"></div>
                <div class="absolute right-[15%] top-[22%] rounded-full border border-rose-200/40 bg-rose-300/15 px-2 py-1 text-xs font-bold text-rose-100">P × V</div>
              </>
            )}
            {isTyphoon && (
              <>
                <div class="absolute left-1/2 top-1/2 h-36 w-36 -translate-x-1/2 -translate-y-1/2 rounded-full border-[14px] border-white/15"></div>
                <div class="absolute left-1/2 top-1/2 h-12 w-12 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/50 bg-slate-950/70"></div>
              </>
            )}
            {isEnsoFoodPrices && (
              <>
                {/* Equatorial warm tongue across the Pacific — not a typhoon spiral */}
                <div class="absolute inset-x-0 top-[38%] h-[28%] bg-gradient-to-r from-sky-900/20 via-cyan-700/35 to-sky-900/20"></div>
                <div class="absolute left-[8%] top-[46%] h-5 w-[84%] rounded-full bg-gradient-to-r from-amber-300/25 via-orange-400/80 to-rose-400/55 shadow-[0_0_28px_rgba(251,146,60,.45)]"></div>
                <div class="absolute left-[22%] top-[48%] h-2.5 w-[42%] rounded-full bg-gradient-to-r from-yellow-200/70 to-orange-300/40"></div>
                {/* Rising grocery-price hint */}
                <div class="absolute bottom-[16%] right-[10%] flex h-[38%] w-[22%] items-end gap-1">
                  <div class="h-[35%] flex-1 rounded-t bg-emerald-200/45"></div>
                  <div class="h-[55%] flex-1 rounded-t bg-emerald-200/60"></div>
                  <div class="h-[78%] flex-1 rounded-t bg-rose-300/70"></div>
                </div>
                <div class="absolute bottom-[52%] right-[12%] text-lg font-bold text-rose-100/90">↗</div>
              </>
            )}
            {isPrisonersDilemma && (
              <>
                {/* 2×2 payoff matrix — two-player game, not a typhoon eye */}
                <div class="absolute left-1/2 top-[18%] h-[58%] w-[62%] -translate-x-1/2 rounded-2xl border border-white/20 bg-slate-950/35 p-2 backdrop-blur-sm">
                  <div class="grid h-full grid-cols-2 grid-rows-2 gap-1.5">
                    <div class="flex items-center justify-center rounded-xl border border-emerald-200/40 bg-emerald-300/20 text-xs font-bold text-emerald-50">C·C</div>
                    <div class="flex items-center justify-center rounded-xl border border-amber-200/35 bg-amber-300/15 text-xs font-bold text-amber-50/90">C·D</div>
                    <div class="flex items-center justify-center rounded-xl border border-amber-200/35 bg-amber-300/15 text-xs font-bold text-amber-50/90">D·C</div>
                    <div class="flex items-center justify-center rounded-xl border border-rose-200/45 bg-rose-400/35 text-xs font-bold text-rose-50 shadow-[0_0_18px_rgba(251,113,133,.35)]">D·D</div>
                  </div>
                </div>
                <div class="absolute left-[12%] top-[14%] rounded-full border border-white/25 bg-black/25 px-2 py-0.5 text-[10px] font-bold tracking-wide text-white/85">2×2</div>
              </>
            )}
            {isButterflyEffect && (
              <>
                {/* Twin trajectories forking — sensitive dependence, not a typhoon eye */}
                <div class="absolute inset-6 rounded-3xl border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 224" fill="none" aria-hidden="true">
                  <path d="M40 150 C 120 148, 160 140, 200 110 C 250 70, 300 40, 360 28" stroke="rgba(103,232,249,.85)" stroke-width="3" stroke-linecap="round"/>
                  <path d="M40 152 C 120 154, 165 170, 210 185 C 260 205, 310 200, 360 168" stroke="rgba(251,113,133,.9)" stroke-width="3" stroke-linecap="round"/>
                  <circle cx="40" cy="151" r="5" fill="rgba(255,255,255,.9)"/>
                </svg>
                <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-cyan-50/90">δx₀</div>
                <div class="absolute right-[10%] top-[12%] text-lg font-bold text-rose-100/90">↗</div>
              </>
            )}


            {isBayesLabResult && (
              <>
                {/* Two prior bars + shared evidence arrow — Bayesian fork */}
                <div class="absolute inset-6 rounded-3xl border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
                <div class="absolute left-[12%] top-[30%] flex h-[46%] w-[22%] flex-col-reverse overflow-hidden rounded-xl border border-white/20">
                  <div class="h-[42%] bg-rose-400/85"></div>
                  <div class="h-[58%] bg-cyan-300/55"></div>
                </div>
                <div class="absolute left-[38%] top-[30%] flex h-[46%] w-[22%] flex-col-reverse overflow-hidden rounded-xl border border-white/20">
                  <div class="h-[12%] bg-rose-400/70"></div>
                  <div class="h-[88%] bg-cyan-300/45"></div>
                </div>
                <div class="absolute right-[10%] top-[42%] flex items-center gap-1 text-amber-100/95">
                  <span class="text-2xl font-bold">→</span>
                  <span class="rounded-lg border border-white/25 bg-white/10 px-2 py-1 text-sm font-bold">+</span>
                </div>
                <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-cyan-50/90">priors</div>
                <div class="absolute right-[10%] top-[14%] rounded-full border border-amber-100/35 bg-amber-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-amber-50/90">same +</div>
              </>
            )}


            {isNormalDistribution && (
              <>
                {/* Bell curve with soft wings — not a typhoon eye */}
                <div class="absolute inset-6 rounded-3xl border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 224" fill="none" aria-hidden="true">
                  <path d="M28 180 C 70 178, 110 160, 140 120 C 170 78, 185 48, 200 40 C 215 48, 230 78, 260 120 C 290 160, 330 178, 372 180" stroke="rgba(165,243,252,.9)" stroke-width="3" stroke-linecap="round"/>
                  <path d="M28 180 C 70 178, 110 160, 140 120 C 170 78, 185 48, 200 40 C 215 48, 230 78, 260 120 C 290 160, 330 178, 372 180 L372 180 L28 180 Z" fill="rgba(103,232,249,.18)"/>
                  <path d="M28 180 C 55 179, 80 170, 95 150 C 105 135, 108 125, 110 120" stroke="rgba(251,113,133,.55)" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M372 180 C 345 179, 320 170, 305 150 C 295 135, 292 125, 290 120" stroke="rgba(251,113,133,.55)" stroke-width="2.5" stroke-linecap="round"/>
                  <line x1="200" y1="40" x2="200" y2="180" stroke="rgba(251,191,36,.7)" stroke-width="1.5" stroke-dasharray="4 4"/>
                </svg>
                <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-cyan-50/90">bell</div>
                <div class="absolute right-[10%] top-[14%] rounded-full border border-rose-100/35 bg-rose-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-rose-50/90">tails</div>
              </>
            )}

            {isCompoundInterest && (
              <>
                {/* Linear ramp vs compounding curve pulling away */}
                <div class="absolute inset-6 rounded-3xl border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 224" fill="none" aria-hidden="true">
                  <path d="M36 168 L360 96" stroke="rgba(103,232,249,.55)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6"/>
                  <path d="M36 168 C 120 166, 190 150, 250 110 C 300 72, 335 42, 360 28" stroke="rgba(251,113,133,.95)" stroke-width="3.5" stroke-linecap="round"/>
                  <circle cx="36" cy="168" r="5" fill="rgba(255,255,255,.9)"/>
                  <circle cx="360" cy="28" r="5" fill="rgba(251,113,133,.95)"/>
                </svg>
                <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-cyan-50/90">(1+r)ⁿ</div>
                <div class="absolute right-[10%] top-[12%] text-lg font-bold text-rose-100/90">↗</div>
              </>
            )}

            {isInflationPurchasingPower && (
              <>
                {/* Nominal bills vs thinning basket slice — purchasing-power dilution */}
                <div class="absolute inset-6 rounded-3xl border border-white/15 bg-slate-950/30 backdrop-blur-sm"></div>
                <div class="absolute left-[12%] top-[28%] flex h-[48%] w-[28%] items-end gap-1.5">
                  <div class="h-[40%] flex-1 rounded-sm bg-cyan-300/50"></div>
                  <div class="h-[58%] flex-1 rounded-sm bg-cyan-300/65"></div>
                  <div class="h-[76%] flex-1 rounded-sm bg-cyan-200/80"></div>
                  <div class="h-[92%] flex-1 rounded-sm bg-cyan-100/90 shadow-[0_0_18px_rgba(165,243,252,.45)]"></div>
                </div>
                <div class="absolute right-[12%] top-[30%] h-[46%] w-[36%] rounded-2xl border-2 border-dashed border-white/25 bg-white/5 p-2">
                  <div class="absolute bottom-2 left-2 right-2 h-[28%] rounded-md bg-gradient-to-t from-rose-400/80 to-amber-300/70 shadow-[0_0_22px_rgba(251,113,133,.35)]"></div>
                </div>
                <div class="absolute left-[10%] top-[14%] rounded-full border border-cyan-100/35 bg-cyan-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-cyan-50/90">nominal ↑</div>
                <div class="absolute right-[10%] top-[14%] rounded-full border border-rose-100/35 bg-rose-100/10 px-2 py-0.5 text-[10px] font-bold tracking-wide text-rose-50/90">real ↓</div>
              </>
            )}
            <div class="absolute inset-x-8 bottom-8 flex items-center justify-between text-white/90">
              <span class="rounded-full border border-white/25 bg-black/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider backdrop-blur">
                {work.type === 'interactive-explainer' ? c.typeExplainer : c.typeStandalone}
              </span>
              <span class="text-4xl" aria-hidden="true">◉</span>
            </div>
          </div>

          <div class="p-6 md:p-7">
            <div class="flex flex-wrap items-center gap-2 text-xs text-surface-500 dark:text-surface-400">
              <time datetime={work.publishedAt}>{new Date(work.publishedAt).toLocaleDateString(locale)}</time>
              <span class:list={[
                'rounded-full px-2.5 py-1 font-semibold',
                work.hasCurrentArtifact
                  ? 'bg-surface-100 text-surface-600 dark:bg-surface-800 dark:text-surface-300'
                  : 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
              ]}>{work.hasCurrentArtifact ? languagesLabel : onlyLabel}</span>
            </div>
            <h2 class="mt-4 font-display text-2xl font-bold text-surface-950 dark:text-white">{work.title}</h2>
            <p class="mt-3 leading-relaxed text-surface-600 dark:text-surface-300">{work.description}</p>
            <a href={work.href} class="mt-6 inline-flex items-center rounded-full bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus:outline-none focus:ring-4 focus:ring-brand-300 dark:focus:ring-brand-900" aria-label={`${work.title} — ${openLabel}`}>
              {openLabel}<span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script is:inline define:vars={{ bannerWorks }}>
  const params = new URLSearchParams(window.location.search);
  const missingSlug = params.get('missing');
  const banner = document.querySelector('[data-missing-visual-banner]');
  const item = missingSlug ? bannerWorks[missingSlug] : null;

  if (banner instanceof HTMLElement && item) {
    const message = banner.querySelector('[data-missing-visual-message]');
    const link = banner.querySelector('[data-missing-visual-link]');
    if (message) message.textContent = item.message;
    if (link instanceof HTMLAnchorElement) {
      link.href = item.href;
      link.textContent = item.openLabel;
    }
    banner.hidden = false;
    banner.focus();
  }
</script>
