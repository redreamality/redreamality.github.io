---
import type { Language } from '../../utils/i18n';
import {
  groupTagsByTheme,
  getTagHref,
  type GroupedTheme,
} from '../../utils/tag-taxonomy';

interface Props {
  lang: Language;
  tags: string[];
  counts: Record<string, number>;
}

const { lang, tags, counts } = Astro.props;

const copy = {
  en: {
    title: 'Knowledge map',
    subtitle: 'A curated taxonomy for exploration — themes, clusters, and tags. Not a keyword dump.',
    empty: 'No tags available yet.',
    jump: 'Jump to theme',
    articles: 'articles',
    article: 'article',
    uncategorizedHint: 'Not yet placed in a curated theme',
    vendorsHint: 'Lab / product hubs — prefer specific themes when writing',
  },
  zh: {
    title: '知识地图',
    subtitle: '面向探索的站点知识体系 — 主题、簇与标签。不是关键词堆。',
    empty: '暂无标签。',
    jump: '跳转到主题',
    articles: '篇',
    article: '篇',
    uncategorizedHint: '尚未归入精品主题',
    vendorsHint: '厂商 / 产品枢纽 — 写作时优先更具体的主题',
  },
  ja: {
    title: '知識マップ',
    subtitle: '探索のためのキュレーション分類 — テーマ、クラスタ、タグ。キーワードの羅列ではありません。',
    empty: 'まだタグがありません。',
    jump: 'テーマへ',
    articles: '件',
    article: '件',
    uncategorizedHint: 'まだテーマに未分類',
    vendorsHint: 'ラボ／製品ハブ — 執筆時は具体テーマを優先',
  },
} as const;

const t = copy[lang];
const themes: GroupedTheme[] = groupTagsByTheme(tags, counts, lang);

// Sticky jump nav: premium themes only (skip muted vendors/other)
const jumpThemes = themes.filter((th) => !th.muted && !th.isOther);
const mutedThemes = themes.filter((th) => th.muted || th.isOther);
const mainThemes = themes.filter((th) => !th.muted && !th.isOther);

function countLabel(n: number): string {
  if (lang === 'zh' || lang === 'ja') return `${n}${t.articles}`;
  return `${n} ${n === 1 ? t.article : t.articles}`;
}
---

<div class="mx-auto max-w-4xl px-4 py-10 md:py-14">
  <header class="mb-10 md:mb-12">
    <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-surface-900 dark:text-white">
      {t.title}
    </h1>
    <p class="mt-3 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-400">
      {t.subtitle}
    </p>
  </header>

  {themes.length === 0 ? (
    <p class="rounded-xl border border-dashed border-surface-300 dark:border-surface-700 px-6 py-12 text-center text-surface-500 dark:text-surface-400">
      {t.empty}
    </p>
  ) : (
    <>
      {jumpThemes.length > 0 && (
        <nav
          class="sticky top-[calc(var(--site-header-height)+0.5rem)] z-10 -mx-1 mb-12 overflow-x-auto rounded-xl border border-surface-200/80 bg-surface-50/90 px-3 py-2.5 backdrop-blur-md dark:border-surface-800 dark:bg-surface-950/90"
          aria-label={t.jump}
        >
          <ul class="flex min-w-max flex-wrap items-center gap-x-1 gap-y-1">
            {jumpThemes.map((theme, i) => (
              <li class="flex items-center gap-1">
                {i > 0 && (
                  <span class="mx-1 select-none text-surface-300 dark:text-surface-700" aria-hidden="true">
                    ·
                  </span>
                )}
                <a
                  href={`#${theme.id}`}
                  class="rounded-md px-2 py-1 text-sm font-medium text-surface-600 transition-colors hover:bg-brand-500/10 hover:text-brand-600 dark:text-surface-400 dark:hover:text-brand-300"
                >
                  {theme.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="flex flex-col gap-16 md:gap-20">
        {mainThemes.map((theme) => (
          <section id={theme.id} class="scroll-mt-[calc(var(--site-header-height)+4rem)]">
            <div class="mb-6 border-b border-surface-200 pb-4 dark:border-surface-800">
              <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-surface-900 dark:text-white">
                {theme.label}
              </h2>
              {theme.description && (
                <p class="mt-2 max-w-2xl text-sm md:text-base leading-relaxed text-surface-500 dark:text-surface-400">
                  {theme.description}
                </p>
              )}
            </div>

            <div class="flex flex-col gap-10">
              {theme.clusters.map((cluster) => (
                <div id={cluster.id} class="scroll-mt-[calc(var(--site-header-height)+4rem)]">
                  {(theme.clusters.length > 1 || cluster.blurb) && (
                    <div class="mb-4">
                      <h3 class="font-display text-lg font-semibold tracking-tight text-surface-800 dark:text-surface-100">
                        {cluster.label}
                      </h3>
                      {cluster.blurb && (
                        <p class="mt-1 max-w-xl text-sm leading-relaxed text-surface-500 dark:text-surface-400">
                          {cluster.blurb}
                        </p>
                      )}
                    </div>
                  )}

                  <ul class="grid gap-3 sm:grid-cols-2">
                    {cluster.tags.map(({ tag, count, displayLabel, blurb }) => (
                      <li>
                        <a
                          href={getTagHref(tag, lang)}
                          class="group flex h-full flex-col rounded-xl border border-surface-200 bg-white px-4 py-3.5 transition-colors hover:border-brand-400/50 hover:bg-brand-500/[0.03] dark:border-surface-700 dark:bg-surface-900 dark:hover:border-brand-400/30 dark:hover:bg-brand-500/5"
                        >
                          <div class="flex items-baseline justify-between gap-3">
                            <span class="font-display text-base font-semibold text-surface-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-300">
                              {displayLabel}
                            </span>
                            <span class="shrink-0 font-mono text-xs tabular-nums text-surface-400 dark:text-surface-500">
                              {countLabel(count)}
                            </span>
                          </div>
                          {blurb && (
                            <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-surface-500 dark:text-surface-400">
                              {blurb}
                            </p>
                          )}
                          <span class="mt-2 font-mono text-[10px] uppercase tracking-wider text-surface-400 dark:text-surface-600">
                            {tag}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      {/* Muted vendors + uncategorized — small type, no sticky jump */}
      {mutedThemes.length > 0 && (
        <aside class="mt-16 space-y-8 border-t border-dashed border-surface-300 pt-10 dark:border-surface-700">
          {mutedThemes.map((theme) => (
            <section
              id={theme.id}
              class="scroll-mt-[calc(var(--site-header-height)+4rem)]"
            >
              <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-surface-400 dark:text-surface-500">
                  {theme.label}
                </h2>
                <p class="text-xs text-surface-400 dark:text-surface-600">
                  {theme.isOther ? t.uncategorizedHint : t.vendorsHint}
                </p>
              </div>
              <ul class="flex flex-wrap gap-1.5">
                {theme.tags.map(({ tag, count, displayLabel }) => (
                  <li>
                    <a
                      href={getTagHref(tag, lang)}
                      class="inline-flex items-baseline gap-1.5 rounded-md border border-surface-200/80 bg-surface-50 px-2 py-1 text-xs text-surface-500 transition-colors hover:border-surface-300 hover:text-surface-700 dark:border-surface-800 dark:bg-surface-950 dark:text-surface-500 dark:hover:border-surface-700 dark:hover:text-surface-300"
                    >
                      <span>{displayLabel}</span>
                      <span class="font-mono tabular-nums text-surface-400 dark:text-surface-600">
                        {count}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </aside>
      )}
    </>
  )}
</div>
