---
import type { Language } from '../../utils/i18n';
import {
  groupTagsByTheme,
  getTagHref,
  type GroupedTheme,
} from '../../utils/tag-taxonomy';

interface Props {
  lang: Language;
  tags: string[];
  counts: Record<string, number>;
}

const { lang, tags, counts } = Astro.props;

const copy = {
  en: {
    title: 'Tags',
    subtitle: 'Browse by theme — a curated taxonomy, not a keyword dump.',
    empty: 'No tags available yet.',
    jump: 'Jump to theme',
    articles: 'articles',
    article: 'article',
  },
  zh: {
    title: '标签',
    subtitle: '按主题浏览 — 站点知识图谱，不是关键词堆。',
    empty: '暂无标签。',
    jump: '跳转到主题',
    articles: '篇',
    article: '篇',
  },
  ja: {
    title: 'タグ',
    subtitle: 'テーマで探す — キーワードの羅列ではなく、整理された分類。',
    empty: 'まだタグがありません。',
    jump: 'テーマへ',
    articles: '件',
    article: '件',
  },
} as const;

const t = copy[lang];
const themes: GroupedTheme[] = groupTagsByTheme(tags, counts, lang);

function countLabel(n: number): string {
  if (lang === 'zh' || lang === 'ja') return `${n}${t.articles}`;
  return `${n} ${n === 1 ? t.article : t.articles}`;
}
---

<div class="mx-auto max-w-3xl px-4 py-10 md:py-14">
  <header class="mb-10 md:mb-12">
    <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-surface-900 dark:text-white">
      {t.title}
    </h1>
    <p class="mt-3 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-400">
      {t.subtitle}
    </p>
  </header>

  {themes.length === 0 ? (
    <p class="rounded-xl border border-dashed border-surface-300 dark:border-surface-700 px-6 py-12 text-center text-surface-500 dark:text-surface-400">
      {t.empty}
    </p>
  ) : (
    <>
      <nav
        class="sticky top-[calc(var(--site-header-height)+0.5rem)] z-10 -mx-1 mb-12 overflow-x-auto rounded-xl border border-surface-200/80 bg-surface-50/90 px-3 py-2.5 backdrop-blur-md dark:border-surface-800 dark:bg-surface-950/90"
        aria-label={t.jump}
      >
        <ul class="flex min-w-max flex-wrap items-center gap-x-1 gap-y-1">
          {themes.map((theme, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && (
                <span class="mx-1 select-none text-surface-300 dark:text-surface-700" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                href={`#${theme.id}`}
                class="rounded-md px-2 py-1 text-sm font-medium text-surface-600 transition-colors hover:bg-brand-500/10 hover:text-brand-600 dark:text-surface-400 dark:hover:text-brand-300"
              >
                {theme.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-16 md:gap-20">
        {themes.map((theme) => (
          <section id={theme.id} class="scroll-mt-[calc(var(--site-header-height)+4rem)]">
            <div class="mb-5 border-b border-surface-200 pb-4 dark:border-surface-800">
              <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-surface-900 dark:text-white">
                {theme.label}
              </h2>
              {theme.description && (
                <p class="mt-2 max-w-2xl text-sm md:text-base leading-relaxed text-surface-500 dark:text-surface-400">
                  {theme.description}
                </p>
              )}
            </div>

            <ul class="flex flex-wrap gap-2">
              {theme.tags.map(({ tag, count }) => (
                <li>
                  <a
                    href={getTagHref(tag, lang)}
                    class="group inline-flex items-baseline gap-1.5 rounded-full border border-surface-200 bg-white px-3 py-1.5 text-sm transition-colors hover:border-brand-400/60 hover:bg-brand-500/5 dark:border-surface-700 dark:bg-surface-900 dark:hover:border-brand-400/40 dark:hover:bg-brand-500/10"
                  >
                    <span class="font-medium text-surface-800 group-hover:text-brand-600 dark:text-surface-200 dark:group-hover:text-brand-300">
                      #{tag}
                    </span>
                    <span class="font-mono text-xs tabular-nums text-surface-400 dark:text-surface-500">
                      {countLabel(count)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </>
  )}
</div>
