---
import type { Language } from '../../utils/i18n';
import { breadcrumbForTag } from '../../utils/tag-taxonomy';

interface Props {
  tag: string;
  lang: Language;
}

const { tag, lang } = Astro.props;
const crumbs = breadcrumbForTag(tag, lang);
const aria =
  lang === 'zh' ? '探索路径' : lang === 'ja' ? '探索パス' : 'Exploration path';
---

<nav
  aria-label={aria}
  class="mb-8 overflow-x-auto rounded-xl border border-surface-200 bg-surface-50/90 px-3.5 py-3 shadow-sm dark:border-surface-700 dark:bg-surface-950/70"
>
  <ol class="flex min-w-max flex-wrap items-center gap-x-1.5 gap-y-1 text-sm md:text-[0.9375rem]">
    {crumbs.map((crumb, i) => (
      <li class="inline-flex items-center gap-1.5">
        {i > 0 && (
          <span
            class="select-none font-medium text-surface-300 dark:text-surface-600"
            aria-hidden="true"
          >
            ›
          </span>
        )}
        {crumb.href ? (
          <a
            href={crumb.href}
            class="rounded-md px-1.5 py-0.5 font-medium text-brand-600 transition-colors hover:bg-brand-500/10 hover:text-brand-700 dark:text-brand-300 dark:hover:bg-brand-500/15 dark:hover:text-brand-200"
          >
            {crumb.label}
          </a>
        ) : (
          <span
            class="rounded-md bg-brand-500/10 px-1.5 py-0.5 font-semibold text-surface-900 dark:bg-brand-500/15 dark:text-white"
            aria-current="page"
          >
            {crumb.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
