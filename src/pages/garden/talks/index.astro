---
import Layout from '../../../layouts/Layout.astro';
import GardenListing from '../../../components/shared/GardenListing.astro';
import { getTalks, type Language } from '../../../utils/i18n';

const lang: Language = 'en';
const talks = await getTalks(lang);
const basePath = '';
const locale = 'en-US';

const strings = {
  kicker: 'Speaking',
  title: 'Talks',
  subtitle: 'Technical talks, conference presentations, and knowledge-sharing sessions.',
  empty: 'No presentations available yet.',
  slides: 'Slides',
  video: 'Video',
};

const items = talks.map((t) => {
  const badges = [] as { icon?: string; label: string }[];
  if (t.data.location) badges.push({ icon: '📍', label: t.data.location });
  if (t.data.slides) badges.push({ icon: '📊', label: strings.slides });
  if (t.data.video) badges.push({ icon: '🎥', label: strings.video });
  return {
    href: `${basePath}/garden/talks/${t.slug}/`,
    title: t.data.title,
    description: t.data.description,
    dateISO: new Date(t.data.date).toISOString(),
    dateLabel: new Date(t.data.date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }),
    badges,
  };
});
---

<Layout title={strings.title} description={strings.subtitle}>
  <GardenListing kicker={strings.kicker} title={strings.title} subtitle={strings.subtitle} emptyMessage={strings.empty} accent="accent" items={items} />
</Layout>
