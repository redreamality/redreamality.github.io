---
import Layout from '../../layouts/Layout.astro';
import TagBreadcrumb from '../../components/tags/TagBreadcrumb.astro';
import { getBlogPosts, getTags, getTagCounts, getLocalizedPath, type Language } from '../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getBlogPosts('en');
  const tags = await getTags('en');

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((post) => post.data.tags?.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      lang: 'en' as Language,
    },
  }));
}

interface Props {
  posts: any[];
  lang: Language;
}

const { tag } = Astro.params;
const { posts, lang } = Astro.props;
const tagCounts = await getTagCounts(lang);

const content = {
  en: {
    articlesCount: 'articles',
    articleCount: 'article',
    readMore: 'Read',
    author: 'by',
  },
  zh: {
    articlesCount: '篇文章',
    articleCount: '篇文章',
    readMore: '阅读',
    author: '作者',
  },
  ja: {
    articlesCount: '件の記事',
    articleCount: '件の記事',
    readMore: '読む',
    author: '著者',
  },
} as const;

const currentContent = content[lang];
const blogBase = getLocalizedPath('/blog/', lang).replace(/\/$/, '');
const tagsBase = getLocalizedPath('/tags/', lang).replace(/\/$/, '');
const locale = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';
---

<Layout title={`#${tag} | ${lang === 'zh' ? '标签' : lang === 'ja' ? 'タグ' : 'Tags'}`}>
  <main class="mx-auto max-w-3xl px-4 py-10 md:py-14">
    <TagBreadcrumb tag={tag!} lang={lang} />

    <header class="mb-10 border-b border-surface-200 pb-6 dark:border-surface-800">
      <h1 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-surface-900 dark:text-white">
        #{tag}
      </h1>
      <p class="mt-2 text-sm text-surface-500 dark:text-surface-400">
        {posts.length}{' '}
        {posts.length === 1 ? currentContent.articleCount : currentContent.articlesCount}
      </p>
    </header>

    <ul class="divide-y divide-surface-200 dark:divide-surface-800">
      {posts.map((post) => (
        <li class="py-6 first:pt-0">
          <article>
            <a href={`${blogBase}/${post.slug}/`} class="group block">
              <h2 class="font-display text-xl font-semibold text-surface-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-300">
                {post.data.title}
              </h2>
            </a>
            <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-surface-500 dark:text-surface-400">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString(locale, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.data.author && (
                <span>
                  {currentContent.author} {post.data.author}
                </span>
              )}
            </div>
            {post.data.description && (
              <p class="mt-2 text-sm leading-relaxed text-surface-600 dark:text-surface-400 line-clamp-2">
                {post.data.description}
              </p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {post.data.tags
                  .filter((t: string) => (tagCounts[t] ?? 0) >= 2)
                  .map((t: string) => (
                    <a
                      href={`${tagsBase}/${encodeURIComponent(t)}/`}
                      class:list={[
                        'rounded-full px-2 py-0.5 text-xs transition-colors',
                        t === tag
                          ? 'bg-brand-500/15 font-medium text-brand-700 dark:text-brand-300'
                          : 'bg-surface-100 text-surface-600 hover:bg-surface-200 dark:bg-surface-800 dark:text-surface-400 dark:hover:bg-surface-700',
                      ]}
                    >
                      #{t}
                    </a>
                  ))}
              </div>
            )}
            <a
              href={`${blogBase}/${post.slug}/`}
              class="mt-3 inline-block text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200"
            >
              {currentContent.readMore} →
            </a>
          </article>
        </li>
      ))}
    </ul>
  </main>
</Layout>
