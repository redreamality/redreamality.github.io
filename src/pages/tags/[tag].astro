---
import Layout from '../../layouts/Layout.astro';
import TagBreadcrumb from '../../components/tags/TagBreadcrumb.astro';
import TagNavbox from '../../components/tags/TagNavbox.astro';
import TagCuratedList from '../../components/tags/TagCuratedList.astro';
import { getBlogPosts, getTags, getTagCounts, type Language } from '../../utils/i18n';
import {
  getTagDisplayLabel,
  getTagBlurb,
  getTagNode,
  pickFeaturedPosts,
  normalizeTag,
  getTagHref,
} from '../../utils/tag-taxonomy';

export async function getStaticPaths() {
  const posts = await getBlogPosts('en');
  const tags = await getTags('en');

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((post) => (post.data.tags || []).some((t) => normalizeTag(t) === tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      lang: 'en' as Language,
      allTags: tags,
    },
  }));
}

interface Props {
  posts: any[];
  lang: Language;
  allTags: string[];
}

const { tag } = Astro.params;
const { posts, lang, allTags } = Astro.props;
const tagCounts = await getTagCounts(lang);
const canonical = normalizeTag(tag!);
const displayName = getTagDisplayLabel(canonical, lang);
const blurb = getTagBlurb(canonical, lang) ?? getTagNode(canonical)?.blurb?.[lang];
const { featured, timeline } = pickFeaturedPosts(canonical, posts);

const content = {
  en: {
    articlesCount: 'articles',
    articleCount: 'article',
    pageSuffix: 'Tags',
  },
  zh: {
    articlesCount: '篇文章',
    articleCount: '篇文章',
    pageSuffix: '标签',
  },
  ja: {
    articlesCount: '件の記事',
    articleCount: '件の記事',
    pageSuffix: 'タグ',
  },
} as const;

const currentContent = content[lang];
const canonicalURL = new URL(getTagHref(canonical, lang), Astro.site).toString();
---

<Layout title={`${displayName} | ${currentContent.pageSuffix}`} canonicalURL={canonicalURL}>
  <main class="mx-auto max-w-3xl px-4 py-10 md:py-14">
    <TagBreadcrumb tag={tag!} lang={lang} />

    <header class="mb-8 border-b border-surface-200 pb-6 dark:border-surface-800">
      <h1 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-surface-900 dark:text-white">
        {displayName}
      </h1>
      {blurb && (
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-surface-600 dark:text-surface-400">
          {blurb}
        </p>
      )}
      <p class="mt-2 text-sm text-surface-500 dark:text-surface-400">
        <span class="font-mono text-xs text-surface-400 dark:text-surface-500">{canonical}</span>
        <span class="mx-2 text-surface-300 dark:text-surface-700">·</span>
        {posts.length}{' '}
        {posts.length === 1 ? currentContent.articleCount : currentContent.articlesCount}
      </p>
    </header>

    <TagNavbox tag={tag!} lang={lang} routeTags={allTags} />

    <TagCuratedList
      lang={lang}
      featured={featured}
      timeline={timeline}
      currentTag={tag!}
      tagCounts={tagCounts}
    />
  </main>
</Layout>
