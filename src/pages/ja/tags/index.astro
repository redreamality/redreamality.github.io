---
import Layout from '../../../layouts/Layout.astro';
import TagsTaxonomy from '../../../components/tags/TagsTaxonomy.astro';
import { getTagCounts, getTags, type Language } from '../../../utils/i18n';

const lang: Language = 'ja';
const tagCounts = await getTagCounts(lang);
const filteredTags = await getTags(lang);
---

<Layout title="タグ">
  <main>
    <TagsTaxonomy lang={lang} tags={filteredTags} counts={tagCounts} />
  </main>
</Layout>
