---
import Layout from '../../layouts/Layout.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import HomeSections from '../../components/home/HomeSections.astro';
import {
  getBlogPosts,
  getChaosPosts,
  getNotes,
  getQuestions,
  getTalks,
  getMeditations,
  getTagCounts,
  type Language,
} from '../../utils/i18n';

// Japanese homepage (/ja/ path)
const lang: Language = 'ja';

const [posts, talks, questions, chaos, notes, meditations, tagCounts] = await Promise.all([
  getBlogPosts(lang),
  getTalks(lang),
  getQuestions(lang),
  getChaosPosts(lang),
  getNotes(lang),
  getMeditations(lang),
  getTagCounts(lang),
]);
---

<Layout title="ホーム">
  <HomeHero lang={lang} />
  <HomeSections
    lang={lang}
    posts={posts}
    meditations={meditations}
    talks={talks}
    questions={questions}
    chaos={chaos}
    notes={notes}
    tagCounts={tagCounts}
  />
</Layout>
