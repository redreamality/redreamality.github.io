---
import SeriesIndex from '../../../../components/series/SeriesIndex.astro';
import { getSeriesConfig } from '../../../../data/series';
import { getBlogPosts, type Language } from '../../../../utils/i18n';
import { getSeriesEntries, getSeriesSlugsWithEntries } from '../../../../utils/series';

// Series (column) index: /ja/blog/series/[series]/
// Only series with at least one entry in this locale get a page (no empty/dead indexes).
const lang: Language = 'ja';

export async function getStaticPaths() {
  const posts = await getBlogPosts('ja');
  return getSeriesSlugsWithEntries(posts).map((series) => ({
    params: { series },
    props: { config: getSeriesConfig(series)!, entries: getSeriesEntries(posts, series) },
  }));
}

const { config, entries } = Astro.props;
---

<SeriesIndex lang={lang} config={config} entries={entries} />
