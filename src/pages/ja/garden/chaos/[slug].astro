---
import Layout from '../../../../layouts/Layout.astro';
import ChaosEntry from '../../../../components/chaos/ChaosEntry.astro';
import { getChaosPosts, type Language } from '../../../../utils/i18n';
import { rankRelatedContent } from '../../../../utils/related';

const lang: Language = 'ja';

export async function getStaticPaths() {
  const posts = await getChaosPosts('ja');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/ja/404', 404);
}

const { Content, headings } = await post.render();
const relatedPosts = rankRelatedContent(await getChaosPosts(lang), post, { dateField: 'pubDate', limit: 6 });
const relatedItems = relatedPosts.map((relatedPost) => ({
  href: `/ja/garden/chaos/${relatedPost.slug}/`,
  title: relatedPost.data.title,
  description: relatedPost.data.description,
  date: relatedPost.data.pubDate,
}));
---

<Layout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.pubDate.toISOString()}
  tags={post.data.tags || []}
  type="article"
>
  <ChaosEntry
    lang={lang}
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    author={post.data.author}
    tags={post.data.tags || []}
    headings={headings}
    relatedItems={relatedItems}
  >
    <Content />
  </ChaosEntry>
</Layout>
