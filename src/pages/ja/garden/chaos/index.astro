---
import Layout from '../../../../layouts/Layout.astro';
import ChaosDigest from '../../../../components/chaos/ChaosDigest.astro';
import { getChaosPosts, type Language } from '../../../../utils/i18n';

const lang: Language = 'ja';
const posts = await getChaosPosts(lang);
const locale = 'ja-JP';

const archive = posts.map((p) => ({
  href: `/ja/garden/chaos/${p.slug}/`,
  title: p.data.title,
  dateLabel: new Date(p.data.pubDate).toLocaleDateString(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
}));
---

<Layout title="カオス" description="直近のホットトピックをテーマ別にまとめます。">
  <ChaosDigest lang={lang} archive={archive} />
</Layout>
