---
import Layout from '../../../../layouts/Layout.astro';
import GardenListing from '../../../../components/shared/GardenListing.astro';
import { getNotes, type Language } from '../../../../utils/i18n';

const lang: Language = 'ja';
const notes = await getNotes(lang);
const basePath = '/ja';
const locale = 'ja-JP';

const strings = {
  kicker: '読書',
  title: '読書ノート',
  subtitle: 'ROI 読書法で整理した読書ノート——読んだ情報を消化した構造化メモです。',
  empty: 'まだノートがありません。',
};

const items = notes.map((n) => ({
  href: `${basePath}/garden/notes/${n.slug}/`,
  title: n.data.title,
  description: n.data.description,
  dateISO: new Date(n.data.date).toISOString(),
  dateLabel: new Date(n.data.date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }),
  tags: n.data.tags,
  tagBasePath: `${basePath}/tags`,
}));
---

<Layout title={strings.title} description={strings.subtitle}>
  <GardenListing kicker={strings.kicker} title={strings.title} subtitle={strings.subtitle} emptyMessage={strings.empty} accent="brand" items={items} />
</Layout>
