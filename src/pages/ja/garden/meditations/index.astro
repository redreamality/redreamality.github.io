---
import Layout from '../../../../layouts/Layout.astro';
import ContentCard from '../../../../components/shared/ContentCard.astro';
import { getMeditations, getTagCounts, type Language } from '../../../../utils/i18n';

const lang: Language = 'ja';
const meditations = await getMeditations(lang);
const tagCounts = await getTagCounts(lang);
const basePath = '/ja';

const strings = {
  title: '瞑想録',
  kicker: '個人的な思索',
  subtitle: 'ブログは学んだことを、瞑想録は腑に落ちたことを記録する。工学について、時間について、AI がすべてを加速させた後に人に残されたものについて——ゆっくりとした思考。',
  empty: 'まだ思索はありません——最初の数編はもうすぐ。',
};
const locale = 'ja-JP';
---

<Layout title={strings.title} description={strings.subtitle}>
  <div class="mx-auto max-w-5xl px-4">
    <header class="mb-12 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-ink-500/30 bg-ink-500/10 px-4 py-1.5 text-xs font-medium tracking-wide text-ink-600 dark:text-ink-400">
        <span class="h-1.5 w-1.5 rounded-full bg-ink-500"></span>{strings.kicker}
      </span>
      <h1 class="mt-5 font-display text-5xl md:text-6xl font-extrabold tracking-tight text-surface-900 dark:text-white">
        {strings.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">
        {strings.subtitle}
      </p>
    </header>

    {meditations.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 p-10 text-center text-surface-500 dark:text-surface-400">
        {strings.empty}
      </p>
    ) : (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {meditations.map((m) => (
          <ContentCard
            href={`${basePath}/garden/meditations/${m.slug}/`}
            title={m.data.title}
            description={m.data.description}
            dateISO={new Date(m.data.date).toISOString()}
            dateLabel={new Date(m.data.date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
            tags={m.data.tags}
            tagBasePath={`${basePath}/tags`}
            tagCounts={tagCounts}
            badges={m.data.theme ? [{ icon: '🪷', label: m.data.theme }] : []}
            accent="ink"
          />
        ))}
      </div>
    )}
  </div>
</Layout>
