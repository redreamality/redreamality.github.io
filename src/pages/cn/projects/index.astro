---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/shared/ProjectCard.astro';
import { projects, projectGroups } from '../../../utils/projectsData';
import type { Language } from '../../../utils/i18n';

const lang: Language = 'zh';
const basePath = '/cn';

const strings = {
  kicker: '开源 · 研究',
  title: '项目',
  subtitle: '开源作品、开发者工具与研究论文——从 AI 智能体、知识抽取，到我自己每天在用的小工具。',
  archive: '想看完整的项目介绍？阅读完整的项目存档。',
  archiveCta: '完整存档',
};

const sortInGroup = (a: typeof projects[number], b: typeof projects[number]) => {
  if (a.featured !== b.featured) return a.featured ? -1 : 1;
  return (b.stars ?? 0) - (a.stars ?? 0);
};

const groups = projectGroups
  .map((g) => ({ ...g, items: projects.filter((p) => p.type === g.type).sort(sortInGroup) }))
  .filter((g) => g.items.length > 0);
---

<Layout title={strings.title} description={strings.subtitle}>
  <div class="mx-auto max-w-6xl px-4">
    <header class="mb-14 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-medium tracking-wide text-brand-600 dark:text-brand-300">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{strings.kicker}
      </span>
      <h1 class="mt-5 font-display text-5xl md:text-6xl font-extrabold tracking-tight text-surface-900 dark:text-white">
        {strings.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">
        {strings.subtitle}
      </p>
    </header>

    <div class="space-y-16">
      {groups.map((g) => (
        <section>
          <h2 class="mb-6 flex items-center gap-3 text-2xl font-display font-bold text-surface-900 dark:text-white">
            <span class="inline-block h-6 w-1.5 rounded-full bg-brand-gradient"></span>
            {g.label[lang]}
            <span class="text-sm font-normal text-surface-400">({g.items.length})</span>
          </h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => <ProjectCard project={p} lang={lang} />)}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-center gap-3 rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 p-8 text-center">
      <p class="text-surface-600 dark:text-surface-300">{strings.archive}</p>
      <a href={`${basePath}/projects/projects/`} class="inline-flex items-center gap-2 rounded-lg bg-surface-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-surface-900 hover:opacity-90 transition-opacity">
        {strings.archiveCta} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Layout>
