---
import Layout from '../../../../layouts/Layout.astro';
import GardenListing from '../../../../components/shared/GardenListing.astro';
import { getQuestions, type Language } from '../../../../utils/i18n';

const lang: Language = 'zh';
const questions = await getQuestions(lang);
const basePath = '/cn';
const locale = 'zh-CN';

const strings = {
  kicker: '提问',
  title: '思考问题',
  subtitle: '我深入思考过的问题。在大模型时代，人最可贵的品质是提出有价值的问题。',
  empty: '暂无思考问题。',
};

const items = questions.map((q) => ({
  href: `${basePath}/garden/questions/${q.slug}/`,
  title: q.data.title,
  description: q.data.description,
  dateISO: new Date(q.data.date).toISOString(),
  dateLabel: new Date(q.data.date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }),
  tags: q.data.tags,
  tagBasePath: `${basePath}/tags`,
}));
---

<Layout title={strings.title} description={strings.subtitle}>
  <GardenListing kicker={strings.kicker} title={strings.title} subtitle={strings.subtitle} emptyMessage={strings.empty} accent="brand" items={items} />
</Layout>
