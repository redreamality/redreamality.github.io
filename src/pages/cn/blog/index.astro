---
import Layout from '../../../layouts/Layout.astro';
import ContentCard from '../../../components/shared/ContentCard.astro';
import { getBlogPosts, getTags, getTagCounts, type Language } from '../../../utils/i18n';

const lang: Language = 'zh';
const posts = await getBlogPosts(lang);
const tags = await getTags(lang);
const tagCounts = await getTagCounts(lang);

const strings = {
  kicker: '写作 · 工程',
  title: '博客',
  subtitle: '技术见解、教程和软件开发思考。',
  tagsTitle: '按标签浏览',
  noPostsMessage: '暂无博客文章。',
};
const basePath = '/cn';
const locale = 'zh-CN';
---

<Layout title={strings.title} description="阅读 Redreamality 的技术博客，这里分享关于软件开发、AI 技术及现代编程实践的深度见解、实用教程与心得体会。">
  <div class="mx-auto max-w-6xl px-4">
    <header class="mb-10 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-medium tracking-wide text-brand-600 dark:text-brand-300">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{strings.kicker}
      </span>
      <h1 class="mt-5 font-display text-5xl md:text-6xl font-extrabold tracking-tight text-surface-900 dark:text-white">{strings.title}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-surface-600 dark:text-surface-300">{strings.subtitle}</p>
    </header>


    {tags.length > 0 && (
      <div class="mb-10">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-surface-500 dark:text-surface-400">{strings.tagsTitle}</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`${basePath}/tags/${tag}/`} class="inline-block rounded-full bg-surface-100 dark:bg-surface-800 px-3 py-1 text-sm text-surface-600 dark:text-surface-300 hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300 transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    {posts.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-surface-300 dark:border-surface-700 p-10 text-center text-surface-500 dark:text-surface-400">{strings.noPostsMessage}</p>
    ) : (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {posts.map((post) => (
          <ContentCard
            href={`${basePath}/blog/${post.slug}/`}
            title={post.data.title}
            description={post.data.description}
            dateISO={new Date(post.data.pubDate).toISOString()}
            dateLabel={new Date(post.data.pubDate).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
            tags={post.data.tags}
            tagBasePath={`${basePath}/tags`}
            tagCounts={tagCounts}
            accent="brand"
          />
        ))}
      </div>
    )}
  </div>
</Layout>
